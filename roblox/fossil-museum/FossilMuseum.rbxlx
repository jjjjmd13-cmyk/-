} :: { [string]: MoundKind }

Config.MoundRespawnTime = 12

----------------------------------------------------------------------
-- 발굴 조수: 데리고 다니면 서 있는 지역에서 자동으로 발굴
----------------------------------------------------------------------
export type Helper = {
	id: string,
	name: string,
	price: number,
	interval: number, -- 몇 초마다 흙더미 하나를 파는지
	color: Color3,
}

Config.Helpers = {
	{ id = "BabyRaptor", name = "아기 랩터", price = 1500, interval = 8, color = Color3.fromRGB(120, 200, 90) },
	{ id = "DigMole", name = "두더지 일꾼", price = 12000, interval = 6.5, color = Color3.fromRGB(140, 100, 80) },
	{ id = "PteroDrone", name = "프테라 드론", price = 120000, interval = 5, color = Color3.fromRGB(230, 200, 120) },
	{ id = "RoboDigger", name = "굴착 로봇", price = 1500000, interval = 4, color = Color3.fromRGB(170, 180, 200) },
	{ id = "GoldGolem", name = "황금 골렘", price = 25000000, interval = 3, color = Color3.fromRGB(255, 205, 60) },
	{ id = "StarSpirit", name = "별의 정령", price = 400000000, interval = 2.2, color = Color3.fromRGB(140, 240, 255) },
} :: { Helper }

Config.HelperById = {} :: { [string]: Helper }
for _, h in Config.Helpers do
	Config.HelperById[h.id] = h
end

Config.HelperSlots = 3
Config.HelperPieceChance = 0.5 -- 조수는 조각이 나올 확률이 흙더미 기본값의 50%

----------------------------------------------------------------------
-- 박물관
----------------------------------------------------------------------
Config.StartSlots = 4
Config.MaxSlots = 16
Config.SlotStep = 2
-- 다음 전시대 확장 가격 (4→6, 6→8, ...)
Config.SlotPrices = { 400, 3000, 15000, 60000, 250000, 1000000 }

Config.LikeBonus = 0.01 -- 좋아요 1개당 수입 +1%
Config.MaxLikeBonus = 1.0 -- 최대 +100%
Config.UniqueBonus = 0.03 -- 서로 다른 화석 1종 완성당 수입 +3%
Config.ZoneCompleteBonus = 0.25 -- 한 지역의 화석을 모두 완성하면 수입 +25%

Config.OfflineRate = 0.5 -- 접속하지 않은 동안 수입의 50%
Config.OfflineMaxSeconds = 3 * 60 * 60 -- 최대 3시간

----------------------------------------------------------------------
-- 환생: 코인, 도구, 지역, 전시대가 초기화되는 대신 영구 보너스
-- (화석 조각과 완성 화석, 좋아요, 조수는 유지)
----------------------------------------------------------------------
Config.Rebirth = {
	basePrice = 5000000,
	growth = 4, -- 환생할 때마다 가격 ×4
	incomeBonus = 0.5, -- 환생 1회당 박물관 수입 +50%
	coinBonus = 0.5, -- 환생 1회당 발굴 코인 +50%
	luckBonus = 0.1, -- 환생 1회당 행운 +10%
}

----------------------------------------------------------------------
-- 매일 접속 보상 (7일 주기). coinsSeconds × 초당 수입, 최소 minCoins
----------------------------------------------------------------------
Config.DailyRewards = {
	{ coinsSeconds = 300, minCoins = 500 },
	{ coinsSeconds = 450, minCoins = 800 },
	{ coinsSeconds = 600, minCoins = 1200 },
	{ coinsSeconds = 900, minCoins = 2000 },
	{ coinsSeconds = 1200, minCoins = 3000 },
	{ coinsSeconds = 1500, minCoins = 5000 },
	{ coinsSeconds = 2400, minCoins = 10000, luckMinutes = 30 },
}

----------------------------------------------------------------------
-- 일일 퀘스트 (매일 3개)
----------------------------------------------------------------------
Config.QuestTemplates = {
	{ type = "Dig", text = "흙더미 %d개 파기", amounts = { 40, 90, 160 } },
	{ type = "Find", text = "화석 조각 %d개 찾기", amounts = { 20, 45, 90 } },
	{ type = "FindRare", text = "희귀 등급 이상 조각 %d개 찾기", amounts = { 2, 5, 10 } },
	{ type = "Assemble", text = "화석 %d개 조립하기", amounts = { 1, 2, 4 } },
	{ type = "Like", text = "다른 박물관에 좋아요 %d번 누르기", amounts = { 1, 2, 3 } },
	{ type = "Meteor", text = "운석 %d개 부수기", amounts = { 1, 3, 5 } },
	{ type = "HelperDig", text = "조수가 흙더미 %d개 파기", amounts = { 20, 50, 100 } },
}
Config.QuestRewardSeconds = { 300, 700, 1500 } -- 난이도별 보상 (초당 수입 × 초)
Config.QuestMinReward = { 800, 2000, 5000 }
Config.QuestAllDoneLuckMinutes = 10 -- 3개 다 끝내면 행운 부스트

----------------------------------------------------------------------
-- 거래
----------------------------------------------------------------------
Config.TradeMaxItems = 12 -- 한쪽이 올릴 수 있는 조각 종류 수
Config.TradeRequestCooldown = 10

----------------------------------------------------------------------
-- 운석 낙하 이벤트
----------------------------------------------------------------------
Config.MeteorInterval = 8 * 60 -- 이벤트 사이 간격(초)
Config.MeteorDuration = 2 * 60 -- 이벤트 지속시간(초)
Config.MeteorsPerZone = 6

Config.AnnounceTier = 5 -- 이 등급 이상을 찾으면 서버 전체에 알림

return Config
]]></string></Properties></Item><Item class="ModuleScript" referent="RBX00000002"><Properties><string name="Name">Economy</string><string name="Source"><![CDATA[-- 뽑기 확률, 수입, 가격 계산 (서버와 클라이언트가 같이 사용)
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(script.Parent.Config)

local Economy = {}

export type Passes = {
	DoubleSpeed: boolean,
	DoubleLuck: boolean,
	DoubleIncome: boolean,
	AutoDig: boolean,
	ExtraHelpers: boolean,
}

function Economy.ZoneMult(zoneId: string): number
	local zone = Config.ZoneById[zoneId]
	return if zone then zone.incomeMult else 1
end

-- 완성 화석 1개의 초당 수입 (배수 적용 전)
function Economy.SpeciesIncome(species: Config.Species): number
	return Config.RarityById[species.rarity].income * Economy.ZoneMult(species.zone)
end

-- 중복 조각 1개 판매가
function Economy.SpeciesSell(species: Config.Species): number
	return Config.RarityById[species.rarity].sell * Economy.ZoneMult(species.zone)
end

function Economy.ServerLuckActive(): boolean
	local untilTime = ReplicatedStorage:GetAttribute("ServerLuckUntil")
	return type(untilTime) == "number" and untilTime > os.time()
end

-- 행운 배수: 1 = 기본. 높을수록 희귀 등급 확률이 크게 증가
function Economy.GetLuck(data: any, passes: Passes, moundLuck: number): number
	local tool = Config.ToolsById[data.tool] or Config.Tools[1]
	local luck = 1 + tool.luck + moundLuck + (data.rebirths or 0) * Config.Rebirth.luckBonus
	if passes.DoubleLuck then
		luck *= 2
	end
	if (data.luckBoostUntil or 0) > os.time() then
		luck *= 1.5
	end
	if Economy.ServerLuckActive() then
		luck *= 2
	end
	return luck
end

function Economy.GetCoinMultiplier(data: any): number
	return 1 + (data.rebirths or 0) * Config.Rebirth.coinBonus
end

local function pickWeighted<T>(items: { T }, weightOf: (T) -> number): T
	local total = 0
	for _, item in items do
		total += weightOf(item)
	end
	local roll = math.random() * total
	for _, item in items do
		roll -= weightOf(item)
		if roll <= 0 then
			return item
		end
	end
	return items[#items]
end

-- 조각 하나 뽑기. 반환: speciesId, pieceIndex
function Economy.RollPiece(luck: number, cosmicChance: number, zoneId: string): (string, number)
	local zoneId2 = zoneId
	local rarity
	if cosmicChance > 0 and math.random() < cosmicChance then
		rarity = Config.RarityById.Cosmic
		zoneId2 = "Event"
	else
		local byRarity = Config.SpeciesByZoneRarity[zoneId] or Config.SpeciesByZoneRarity.Desert
		local pool = {}
		for _, r in Config.Rarities do
			if not r.eventOnly and r.weight > 0 and byRarity[r.id] then
				table.insert(pool, r)
			end
		end
		rarity = pickWeighted(pool, function(r)
			-- 등급이 높을수록 행운의 영향을 크게 받음
			return r.weight * luck ^ ((r.tier - 1) * 0.6)
		end)
	end
	local byRarity = Config.SpeciesByZoneRarity[zoneId2] or Config.SpeciesByZoneRarity.Desert
	local speciesList = byRarity[rarity.id]
	local species = speciesList[math.random(1, #speciesList)]
	return species.id, math.random(1, #Config.GetPieces(species))
end

-- 전시 중인 화석 목록 (수입 높은 순, 전시대 개수만큼)
function Economy.GetDisplayed(data: any): { string }
	local list = {}
	for speciesId, count in data.museum do
		if Config.SpeciesById[speciesId] then
			for _ = 1, math.min(count, data.slots) do
				table.insert(list, speciesId)
			end
		end
	end
	table.sort(list, function(a, b)
		local ia = Economy.SpeciesIncome(Config.SpeciesById[a])
		local ib = Economy.SpeciesIncome(Config.SpeciesById[b])
		if ia ~= ib then
			return ia > ib
		end
		return a < b
	end)
	while #list > data.slots do
		table.remove(list)
	end
	return list
end

-- 지역별 완성 현황: { [zoneId] = { done = n, total = n } }
function Economy.GetZoneProgress(data: any): { [string]: { done: number, total: number } }
	local result = {}
	for _, species in Config.Species do
		local entry = result[species.zone]
		if not entry then
			entry = { done = 0, total = 0 }
			result[species.zone] = entry
		end
		entry.total += 1
		if (data.museum[species.id] or 0) > 0 then
			entry.done += 1
		end
	end
	return result
end

function Economy.GetIncomeMultiplier(data: any, passes: Passes): number
	local unique = 0
	for speciesId, count in data.museum do
		if count > 0 and Config.SpeciesById[speciesId] then
			unique += 1
		end
	end
	local zonesDone = 0
	for _, entry in Economy.GetZoneProgress(data) do
		if entry.done >= entry.total then
			zonesDone += 1
		end
	end
	local mult = 1
	mult += math.min(data.likes * Config.LikeBonus, Config.MaxLikeBonus)
	mult += unique * Config.UniqueBonus
	mult += zonesDone * Config.ZoneCompleteBonus
	mult += (data.rebirths or 0) * Config.Rebirth.incomeBonus
	if passes.DoubleIncome then
		mult *= 2
	end
	return mult
end

-- 초당 수입
function Economy.GetIncome(data: any, passes: Passes): number
	local base = 0
	for _, speciesId in Economy.GetDisplayed(data) do
		base += Economy.SpeciesIncome(Config.SpeciesById[speciesId])
	end
	return base * Economy.GetIncomeMultiplier(data, passes)
end

function Economy.HasAllPieces(data: any, speciesId: string): boolean
	local species = Config.SpeciesById[speciesId]
	local owned = data.pieces[speciesId]
	if not species or not owned then
		return false
	end
	for i = 1, #Config.GetPieces(species) do
		if (owned[tostring(i)] or 0) < 1 then
			return false
		end
	end
	return true
end

-- 중복 조각(각 조각 1개씩 남기고) 판매 가격
function Economy.GetDuplicateValue(data: any): number
	local total = 0
	for speciesId, owned in data.pieces do
		local species = Config.SpeciesById[speciesId]
		if species then
			local price = Economy.SpeciesSell(species)
			for _, count in owned do
				if count > 1 then
					total += (count - 1) * price
				end
			end
		end
	end
	return total
end

function Economy.GetNextSlotPrice(data: any): number?
	if data.slots >= Config.MaxSlots then
		return nil
	end
	local index = (data.slots - Config.StartSlots) // Config.SlotStep + 1
	return Config.SlotPrices[index]
end

function Economy.GetDigCooldown(data: any, passes: Passes): number
	local tool = Config.ToolsById[data.tool] or Config.Tools[1]
	return tool.cooldown * (if passes.DoubleSpeed then 0.5 else 1)
end

function Economy.GetRebirthPrice(data: any): number
	return Config.Rebirth.basePrice * Config.Rebirth.growth ^ (data.rebirths or 0)
end

function Economy.GetHelperSlots(passes: Passes): number
	return Config.HelperSlots + (if passes.ExtraHelpers then 2 else 0)
end

function Economy.CountEquipped(data: any, helperId: string): number
	local n = 0
	for _, id in data.helpersEquipped do
		if id == helperId then
			n += 1
		end
	end
	return n
end

return Economy
]]></string></Properties></Item><Item class="ModuleScript" referent="RBX00000003"><Properties><string name="Name">Util</string><string name="Source"><![CDATA[local Util = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi" }

-- 1234 -> "1,234", 1234567 -> "1.23M"
function Util.FormatNumber(n: number): string
	n = math.floor(n)
	if n < 100000 then
		local s = tostring(n)
		local formatted = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
		if formatted:sub(1, 1) == "," then
			formatted = formatted:sub(2)
		end
		return formatted
	end
	local index = 1
	local value = n
	while value >= 1000 and index < #SUFFIXES do
		value /= 1000
		index += 1
	end
	return string.format("%.2f%s", value, SUFFIXES[index])
end

function Util.FormatTime(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local h = seconds // 3600
	local m = (seconds % 3600) // 60
	local s = seconds % 60
	if h > 0 then
		return string.format("%d:%02d:%02d", h, m, s)
	end
	return string.format("%d:%02d", m, s)
end

function Util.DeepCopy<T>(value: T): T
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in value :: any do
		copy[k] = Util.DeepCopy(v)
	end
	return copy :: any
end

return Util
]]></string></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX00000016"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX00000015"><Properties><string name="Name">Server</string></Properties><Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">DataService</string><string name="Source"><![CDATA[-- 플레이어 데이터 불러오기 / 저장
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)

local DataService = {}

local STORE_NAME = "FossilMuseum_v1"
local AUTOSAVE_INTERVAL = 120

local TEMPLATE = {
	coins = 0,
	tool = "WoodShovel",
	ownedTools = { WoodShovel = true },
	pieces = {}, -- [speciesId] = { ["1"] = 개수, ["2"] = 개수, ... }
	museum = {}, -- [speciesId] = 완성한 개수
	slots = Config.StartSlots,
	likes = 0,
	likedGiven = {}, -- [대상 UserId] = 좋아요 누른 날짜 번호
	luckBoostUntil = 0,
	lastOnline = 0,
	purchases = {}, -- 처리한 개발자 상품 PurchaseId (중복 지급 방지)
	unlockedZones = { Desert = true },
	rebirths = 0,
	helpersOwned = {}, -- [helperId] = 가진 개수
	helpersEquipped = {}, -- { helperId, ... }
	daily = { last = 0, streak = 0 }, -- 마지막으로 받은 날짜 번호, 연속 일수
	quests = { day = 0, list = {} },
	weekLikes = { week = 0, count = 0 },
	autoDig = true, -- 자동 발굴 패스가 있을 때 켜짐/꺼짐
	stats = { dug = 0, found = 0, meteors = 0, helperDug = 0, totalEarned = 0 },
}

type Profile = {
	data: any,
	canSave: boolean,
}

local profiles: { [Player]: Profile } = {}
local loadedEvent = Instance.new("BindableEvent")
DataService.Loaded = loadedEvent.Event -- (player, data, offlineSeconds)

local store: DataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[DataService] DataStore 를 사용할 수 없어요:", result)
	end
end

local function keyFor(player: Player): string
	return "u_" .. player.UserId
end

-- 저장된 데이터에 없는 항목을 기본값으로 채움 (업데이트로 항목이 늘어났을 때)
local function reconcile(data: any, template: any)
	for key, value in template do
		if data[key] == nil then
			data[key] = Util.DeepCopy(value)
		elseif type(value) == "table" and type(data[key]) == "table" and next(value) ~= nil then
			reconcile(data[key], value)
		end
	end
end

function DataService.Today(): number
	return os.time() // 86400
end

-- 월요일 기준 주 번호
function DataService.Week(): number
	return (os.time() // 86400 + 3) // 7
end

local function load(player: Player)
	local data = nil
	local failed = false

	if store then
		for attempt = 1, 3 do
			local ok, result = pcall(function()
				return (store :: DataStore):GetAsync(keyFor(player))
			end)
			if ok then
				data = result
				failed = false
				break
			end
			failed = true
			warn(string.format("[DataService] %s 데이터 불러오기 실패 (%d/3): %s", player.Name, attempt, tostring(result)))
			if RunService:IsStudio() then
				break -- Studio 에서는 기다리지 않고 바로 임시 데이터로 시작
			end
			task.wait(attempt * 1.5)
		end
	else
		failed = true
	end

	if failed and not RunService:IsStudio() then
		player:Kick("데이터를 불러오지 못했어요. 잠시 후 다시 접속해 주세요.")
		return
	end
	if failed then
		warn("[DataService] Studio 테스트: 임시 데이터로 시작합니다 (저장 안 됨). 게임 설정 > 보안 > 'Studio에서 API 서비스 사용'을 켜면 저장돼요.")
	end
	if player.Parent == nil then
		return
	end

	if type(data) ~= "table" then
		data = Util.DeepCopy(TEMPLATE)
	end
	reconcile(data, TEMPLATE)

	-- 오래된 좋아요 기록 정리
	local today = DataService.Today()
	for target, day in data.likedGiven do
		if day ~= today then
			data.likedGiven[target] = nil
		end
	end
	if not Config.ToolsById[data.tool] or not data.ownedTools[data.tool] then
		data.tool = "WoodShovel"
		data.ownedTools.WoodShovel = true
	end
	-- 없어진 조수 정리
	for i = #data.helpersEquipped, 1, -1 do
		local id = data.helpersEquipped[i]
		if not Config.HelperById[id] or (data.helpersOwned[id] or 0) <= 0 then
			table.remove(data.helpersEquipped, i)
		end
	end

	local offlineSeconds = 0
	if data.lastOnline > 0 then
		offlineSeconds = math.clamp(os.time() - data.lastOnline, 0, Config.OfflineMaxSeconds)
	end
	data.lastOnline = os.time()

	profiles[player] = { data = data, canSave = not failed }
	loadedEvent:Fire(player, data, offlineSeconds)
end

function DataService.Get(player: Player): any
	local profile = profiles[player]
	return profile and profile.data
end

function DataService.Save(player: Player): boolean
	local profile = profiles[player]
	if not profile or not profile.canSave or not store then
		return false
	end
	profile.data.lastOnline = os.time()
	local ok, err = pcall(function()
		(store :: DataStore):UpdateAsync(keyFor(player), function()
			return profile.data
		end)
	end)
	if not ok then
		warn(string.format("[DataService] %s 저장 실패: %s", player.Name, tostring(err)))
	end
	return ok
end

function DataService.Init()
	Players.PlayerAdded:Connect(load)
	for _, player in Players:GetPlayers() do
		task.spawn(load, player)
	end

	Players.PlayerRemoving:Connect(function(player)
		DataService.Save(player)
		profiles[player] = nil
	end)

	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_INTERVAL)
			for player in profiles do
				task.spawn(DataService.Save, player)
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				DataService.Save(player)
				pending -= 1
			end)
		end
		local started = os.clock()
		while pending > 0 and os.clock() - started < 25 do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></string></Properties></Item><Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">DigService</string><string name="Source"><![CDATA[-- 발굴: 흙더미 생성, 삽질 처리, 운석 이벤트, 도구 지급
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Economy = require(ReplicatedStorage.Shared.Economy)
local Util = require(ReplicatedStorage.Shared.Util)
local DataService = require(script.Parent.DataService)
local Passes = require(script.Parent.Passes)
local Net = require(script.Parent.Net)
local Rewards = require(script.Parent.Rewards)
local Zones = require(script.Parent.Zones)

local DigService = {}

local TAG = "DigMound"
local MOUND_SIZE = Vector3.new(6, 3, 6)
local METEOR_SIZE = 5

local world: any = nil
local lastDig: { [Player]: number } = {}
local lastLockedWarn: { [Player]: number } = {}

----------------------------------------------------------------------
-- 도구
----------------------------------------------------------------------
local function buildTool(def: Config.DigTool): Tool
	local tool = Instance.new("Tool")
	tool.Name = def.name
	tool.CanBeDropped = false
	tool.ToolTip = "흙더미를 클릭하거나 누르고 있으면 파요"
	tool:SetAttribute("DigTool", def.id)
	-- 손잡이 끝을 쥐고, 삽날이 앞쪽으로
	tool.Grip = CFrame.fromMatrix(Vector3.new(0, 0, -1.5), Vector3.new(0, 1, 0), Vector3.new(0, 0, 1))

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.3, 0.3, 4)
	handle.Material = Enum.Material.Wood
	handle.Color = Color3.fromRGB(120, 85, 50)
	handle.CanCollide = false
	handle.Massless = true
	handle.Parent = tool

	local head = Instance.new("Part")
	head.Name = "Head"
	head.Size = Vector3.new(1.3, 0.2, 1.4)
	local glowing = def.power >= 14
	head.Material = if glowing then Enum.Material.Neon else Enum.Material.Metal
	head.Color = def.color
	head.CanCollide = false
	head.Massless = true
	head.CFrame = handle.CFrame * CFrame.new(0, 0, 2.5)
	head.Parent = tool
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = handle
	weld.Part1 = head
	weld.Parent = handle
	if glowing then
		local light = Instance.new("PointLight")
		light.Color = def.color
		light.Range = 6
		light.Parent = head
	end
	return tool
end

function DigService.GiveTool(player: Player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	local def = Config.ToolsById[data.tool] or Config.Tools[1]
	local wasEquipped = false
	for _, container in { player:FindFirstChildOfClass("Backpack"), player.Character } do
		if container then
			for _, child in container:GetChildren() do
				if child:IsA("Tool") and child:GetAttribute("DigTool") then
					if child.Parent == player.Character then
						wasEquipped = true
					end
					child:Destroy()
				end
			end
		end
	end
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not backpack then
		return
	end
	local tool = buildTool(def)
	tool.Parent = backpack
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if wasEquipped and humanoid then
		humanoid:EquipTool(tool)
	end
end

----------------------------------------------------------------------
-- 흙더미
----------------------------------------------------------------------
local function rollMoundKind(): string
	local total = 0
	for _, kind in Config.Mounds do
		total += kind.spawnWeight
	end
	local roll = math.random() * total
	for id, kind in Config.Mounds do
		if kind.spawnWeight > 0 then
			roll -= kind.spawnWeight
			if roll <= 0 then
				return id
			end
		end
	end
	return "Dirt"
end

local function addSparkle(mound: BasePart, color: Color3)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "Sparkle"
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Color = ColorSequence.new(color)
	emitter.Size = NumberSequence.new(0.5)
	emitter.Rate = 6
	emitter.Lifetime = NumberRange.new(0.8, 1.5)
	emitter.Speed = NumberRange.new(1, 2)
	emitter.SpreadAngle = Vector2.new(60, 60)
	emitter.Parent = mound
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 8
	light.Brightness = 1
	light.Parent = mound
end

local function setupMound(mound: BasePart, kindId: string, zoneId: string)
	local kind = Config.Mounds[kindId]
	local zone = Config.ZoneById[zoneId] or Config.Zones[1]
	local hp = math.ceil(kind.hp * zone.hpMult)
	mound.Name = kindId
	if kindId == "Meteor" then
		mound.Color = Color3.fromRGB(80, 40, 120)
	elseif kindId == "Sparkle" then
		mound.Color = zone.moundColor:Lerp(Color3.fromRGB(255, 210, 90), 0.35)
	else
		mound.Color = zone.moundColor
	end
	mound:SetAttribute("Kind", kindId)
	mound:SetAttribute("Zone", zone.id)
	mound:SetAttribute("HP", hp)
	mound:SetAttribute("MaxHP", hp)
	for _, child in mound:GetChildren() do
		if child:IsA("ParticleEmitter") or child:IsA("PointLight") then
			child:Destroy()
		end
	end
	if kindId == "Sparkle" then
		addSparkle(mound, Color3.fromRGB(255, 220, 90))
	end
end

local function makeMound(zoneWorld: any, position: Vector3, kindId: string): Part
	local zone = Config.ZoneById[zoneWorld.id]
	local mound = Instance.new("Part")
	mound.Anchored = true
	mound.Size = MOUND_SIZE
	mound.CFrame = CFrame.new(position + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, math.random() * math.pi * 2, 0)
	mound.Material = zone.moundMaterial
	mound.CanCollide = true
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = mound
	setupMound(mound, kindId, zone.id)
	mound.Parent = zoneWorld.field
	CollectionService:AddTag(mound, TAG)
	return mound
end

local function updateMoundSize(mound: BasePart)
	local hp = mound:GetAttribute("HP") :: number
	local maxHp = mound:GetAttribute("MaxHP") :: number
	local ratio = 0.35 + 0.65 * math.clamp(hp / maxHp, 0, 1)
	if mound:GetAttribute("Kind") == "Meteor" then
		mound.Size = Vector3.one * METEOR_SIZE * (0.5 + 0.5 * ratio)
	else
		mound.Size = Vector3.new(MOUND_SIZE.X * (0.7 + 0.3 * ratio), MOUND_SIZE.Y * ratio, MOUND_SIZE.Z * (0.7 + 0.3 * ratio))
	end
end

local function hideMound(mound: BasePart)
	mound.Transparency = 1
	mound.CanCollide = false
	mound.CanQuery = false
	for _, child in mound:GetChildren() do
		if child:IsA("ParticleEmitter") or child:IsA("PointLight") or child:IsA("Fire") then
			(child :: any).Enabled = false
		end
	end
end

local function respawnMound(mound: Part)
	setupMound(mound, rollMoundKind(), mound:GetAttribute("Zone") :: string)
	mound.Size = Vector3.new(MOUND_SIZE.X, 0.2, MOUND_SIZE.Z)
	mound.Transparency = 0
	mound.CanCollide = true
	mound.CanQuery = true
	TweenService:Create(mound, TweenInfo.new(0.6, Enum.EasingStyle.Back), { Size = MOUND_SIZE }):Play()
end

----------------------------------------------------------------------
-- 삽질 요청 처리
----------------------------------------------------------------------
local function onDig(player: Player, mound: any)
	if typeof(mound) ~= "Instance" or not mound:IsA("BasePart") or not CollectionService:HasTag(mound, TAG) then
		return
	end
	local data = DataService.Get(player)
	if not data then
		return
	end
	local now = os.clock()
	local cooldown = Economy.GetDigCooldown(data, Passes.Get(player))
	if now - (lastDig[player] or 0) < cooldown * 0.85 then
		return
	end

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root or not character then
		return
	end
	if (root.Position - mound.Position).Magnitude > Config.DigRange then
		return
	end
	local held = character:FindFirstChildOfClass("Tool")
	if not held or not held:GetAttribute("DigTool") then
		return
	end
	local zoneId = mound:GetAttribute("Zone") :: string
	if not Zones.IsUnlocked(data, zoneId) then
		if now - (lastLockedWarn[player] or 0) > 3 then
			lastLockedWarn[player] = now
			local zone = Config.ZoneById[zoneId]
			Net.Tell(player, string.format("🔒 %s은(는) 아직 잠겨 있어요 (💰 %s)", zone.name, Util.FormatNumber(zone.price)), Color3.fromRGB(255, 150, 150))
		end
		return
	end
	local hp = mound:GetAttribute("HP") :: number
	if not hp or hp <= 0 then
		return
	end
	lastDig[player] = now

	local tool = Config.ToolsById[data.tool] or Config.Tools[1]
	hp -= tool.power
	mound:SetAttribute("HP", hp)
	local kindId = mound:GetAttribute("Kind") :: string
	Net.Effect:FireAllClients("Dig", mound.Position, mound.Color, hp <= 0)

	if hp > 0 then
		updateMoundSize(mound)
		return
	end

	hideMound(mound)
	Rewards.Dig(player, data, kindId, zoneId, mound.Position)
	if kindId == "Meteor" then
		task.delay(1, function()
			mound:Destroy()
		end)
	else
		task.delay(Config.MoundRespawnTime, function()
			if mound.Parent then
				respawnMound(mound :: Part)
			end
		end)
	end
end

----------------------------------------------------------------------
-- 운석 이벤트 (모든 지역에 떨어짐)
----------------------------------------------------------------------
local meteors = {}

local function spawnMeteor(zoneWorld: any)
	local ring = zoneWorld.meteorRing
	local angle = math.random() * math.pi * 2
	local radius = ring.inner + math.random() * (ring.outer - ring.inner)
	local ground = zoneWorld.center + Vector3.new(math.cos(angle) * radius, METEOR_SIZE * 0.35, math.sin(angle) * radius)

	local meteor = Instance.new("Part")
	meteor.Shape = Enum.PartType.Ball
	meteor.Anchored = true
	meteor.Size = Vector3.one * METEOR_SIZE
	meteor.Material = Enum.Material.Basalt
	meteor.CanQuery = false
	meteor.CanCollide = false
	meteor.Position = ground + Vector3.new(30, 200, 20)
	setupMound(meteor, "Meteor", zoneWorld.id)
	addSparkle(meteor, Color3.fromRGB(180, 90, 255))
	local fire = Instance.new("Fire")
	fire.Color = Color3.fromRGB(170, 90, 255)
	fire.SecondaryColor = Color3.fromRGB(80, 200, 255)
	fire.Size = 8
	fire.Parent = meteor
	meteor.Parent = zoneWorld.field
	table.insert(meteors, meteor)

	local tween = TweenService:Create(meteor, TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = ground })
	tween:Play()
	tween.Completed:Wait()
	if not meteor.Parent then
		return
	end
	fire.Size = 3
	local boom = Instance.new("Explosion")
	boom.BlastPressure = 0
	boom.BlastRadius = 0
	boom.DestroyJointRadiusPercent = 0
	boom.Position = ground
	boom.Parent = workspace
	meteor.CanQuery = true
	meteor.CanCollide = true
	CollectionService:AddTag(meteor, TAG)
end

local function meteorLoop()
	local first = true
	while true do
		local waitTime = Config.MeteorInterval
		if first and RunService:IsStudio() then
			waitTime = 45 -- Studio 테스트 때는 빨리 시작
		end
		first = false
		ReplicatedStorage:SetAttribute("MeteorActive", false)
		ReplicatedStorage:SetAttribute("NextMeteorAt", workspace:GetServerTimeNow() + waitTime)
		task.wait(waitTime)

		ReplicatedStorage:SetAttribute("MeteorActive", true)
		ReplicatedStorage:SetAttribute("MeteorEndsAt", workspace:GetServerTimeNow() + Config.MeteorDuration)
		Net.Announce("☄️ 운석이 떨어지고 있어요! 모든 발굴 지역에서 우주 화석을 찾아보세요!", Color3.fromRGB(180, 120, 255))
		for _, zoneWorld in world.zones do
			for _ = 1, Config.MeteorsPerZone do
				task.delay(math.random() * 8, spawnMeteor, zoneWorld)
			end
		end
		task.wait(Config.MeteorDuration)

		for _, meteor in meteors do
			if meteor.Parent then
				meteor:Destroy()
			end
		end
		table.clear(meteors)
		Net.Announce("운석 낙하가 끝났어요. 다음 운석을 기다려 주세요!", Color3.fromRGB(200, 200, 200))
	end
end

----------------------------------------------------------------------
function DigService.Init(builtWorld: any)
	world = builtWorld
	for _, zoneWorld in world.zones do
		for _, spot in zoneWorld.spots do
			makeMound(zoneWorld, spot, rollMoundKind())
		end
	end

	Net.Dig.OnServerEvent:Connect(onDig)

	local function onCharacter(player: Player)
		-- 데이터가 준비될 때까지 기다렸다가 도구 지급
		task.spawn(function()
			local started = os.clock()
			while not DataService.Get(player) and player.Parent and os.clock() - started < 30 do
				task.wait(0.2)
			end
			if player.Parent then
				DigService.GiveTool(player)
			end
		end)
	end
	local function onPlayer(player: Player)
		player.CharacterAdded:Connect(function()
			onCharacter(player)
		end)
		if player.Character then
			onCharacter(player)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		lastDig[player] = nil
		lastLockedWarn[player] = nil
	end)

	task.spawn(meteorLoop)
end

return DigService
]]></string></Properties></Item><Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">FossilModel</string><string name="Source"><![CDATA[-- 완성 화석의 3D 뼈대 모형을 파트로 만들어 줌 (에셋 없이 동작)
-- 모형은 로컬 +X 방향이 머리, 원점은 전시대 윗면 중앙입니다.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Economy = require(ReplicatedStorage.Shared.Economy)
local Util = require(ReplicatedStorage.Shared.Util)

local FossilModel = {}

local BONE = Color3.fromRGB(236, 226, 200)

type Style = { color: Color3, material: Enum.Material, transparency: number }

local function styleFor(rarityId: string): Style
	if rarityId == "Mythic" then
		return { color = Color3.fromRGB(255, 150, 190), material = Enum.Material.Glass, transparency = 0.15 }
	elseif rarityId == "Cosmic" then
		return { color = Color3.fromRGB(120, 255, 240), material = Enum.Material.Neon, transparency = 0 }
	elseif rarityId == "Legendary" then
		return { color = Color3.fromRGB(245, 225, 170), material = Enum.Material.SmoothPlastic, transparency = 0 }
	end
	return { color = BONE, material = Enum.Material.SmoothPlastic, transparency = 0 }
end

type Builder = {
	model: Model,
	base: CFrame,
	style: Style,
}

local function newPart(b: Builder, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	if shape then
		p.Shape = shape
	end
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = true
	p.Color = b.style.color
	p.Material = b.style.material
	p.Transparency = b.style.transparency
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = b.model
	return p
end

-- a 에서 c 까지 이어지는 원기둥 뼈
local function bone(b: Builder, a: Vector3, c: Vector3, thick: number)
	local wa = b.base:PointToWorldSpace(a)
	local wc = b.base:PointToWorldSpace(c)
	local dir = wc - wa
	local len = dir.Magnitude
	if len < 0.05 then
		return
	end
	local up = b.base:VectorToWorldSpace(Vector3.yAxis)
	if math.abs(dir.Unit:Dot(up)) > 0.98 then
		up = b.base:VectorToWorldSpace(Vector3.xAxis)
	end
	local p = newPart(b, Enum.PartType.Cylinder)
	p.Size = Vector3.new(len + thick * 0.5, thick, thick)
	p.CFrame = CFrame.lookAt((wa + wc) / 2, wc, up) * CFrame.Angles(0, math.pi / 2, 0)
end

local function ball(b: Builder, at: Vector3, size: number)
	local p = newPart(b, Enum.PartType.Ball)
	p.Size = Vector3.new(size, size, size)
	p.CFrame = b.base * CFrame.new(at)
end

local function block(b: Builder, at: Vector3, size: Vector3, rot: CFrame?)
	local p = newPart(b)
	p.Size = size
	p.CFrame = b.base * CFrame.new(at) * (rot or CFrame.identity)
end

local function stand(b: Builder, height: number)
	local p = newPart(b, Enum.PartType.Cylinder)
	p.Color = Color3.fromRGB(60, 60, 65)
	p.Material = Enum.Material.Metal
	p.Transparency = 0
	p.Size = Vector3.new(height, 0.3, 0.3)
	p.CFrame = b.base * CFrame.new(0, height / 2, 0) * CFrame.Angles(0, 0, math.pi / 2)
end

local function ribs(b: Builder, from: Vector3, to: Vector3, count: number, depth: number, width: number, thick: number)
	for i = 1, count do
		local t = i / (count + 1)
		local p = from:Lerp(to, t)
		local d = depth * (1 - math.abs(t - 0.5) * 0.8)
		for _, side in { -1, 1 } do
			local mid = p + Vector3.new(0, -d * 0.45, side * width)
			bone(b, p, mid, thick)
			bone(b, mid, p + Vector3.new(0, -d, side * width * 0.4), thick)
		end
	end
end

local function skull(b: Builder, at: Vector3, s: number, look: Config.Look)
	local h = (look.head or 1) * s
	block(b, at, Vector3.new(1.3 * h, 0.8 * h, 0.8 * h))
	-- 아래턱
	block(b, at + Vector3.new(0.15 * h, -0.5 * h, 0), Vector3.new(1.1 * h, 0.22 * h, 0.6 * h), CFrame.Angles(0, 0, math.rad(-8)))
	-- 눈구멍
	for _, side in { -1, 1 } do
		local eye = newPart(b, Enum.PartType.Ball)
		eye.Color = Color3.fromRGB(40, 35, 30)
		eye.Material = Enum.Material.SmoothPlastic
		eye.Transparency = 0
		eye.Size = Vector3.new(0.28, 0.28, 0.28) * h
		eye.CFrame = b.base * CFrame.new(at + Vector3.new(0.1 * h, 0.15 * h, side * 0.38 * h))
	end
	if look.horns then
		for _, side in { -1, 1 } do
			bone(b, at + Vector3.new(0.1 * h, 0.35 * h, side * 0.3 * h), at + Vector3.new(0.7 * h, 1.0 * h, side * 0.45 * h), 0.14 * h)
		end
		bone(b, at + Vector3.new(0.6 * h, 0.3 * h, 0), at + Vector3.new(0.9 * h, 0.7 * h, 0), 0.12 * h)
	end
	if look.tusks then
		for _, side in { -1, 1 } do
			local root = at + Vector3.new(0.5 * h, -0.3 * h, side * 0.3 * h)
			local mid = root + Vector3.new(0.6 * h, -0.8 * h, side * 0.2 * h)
			bone(b, root, mid, 0.18 * h)
			bone(b, mid, mid + Vector3.new(0.6 * h, 0.5 * h, side * 0.1 * h), 0.15 * h)
		end
	end
end

local function quadruped(b: Builder, s: number, look: Config.Look)
	local shoulder = Vector3.new(1.6 * s, 2.6 * s, 0)
	local hip = Vector3.new(-1.6 * s, 2.5 * s, 0)
	bone(b, shoulder, hip, 0.42 * s)
	ribs(b, hip, shoulder, 5, 1.2 * s, 0.6 * s, 0.14 * s)
	for _, side in { -0.6, 0.6 } do
		local z = side * s
		bone(b, shoulder + Vector3.new(0, 0, z), Vector3.new(1.8 * s, 1.2 * s, z), 0.32 * s)
		bone(b, Vector3.new(1.8 * s, 1.2 * s, z), Vector3.new(1.7 * s, 0, z), 0.28 * s)
		bone(b, hip + Vector3.new(0, 0, z), Vector3.new(-1.3 * s, 1.2 * s, z), 0.36 * s)
		bone(b, Vector3.new(-1.3 * s, 1.2 * s, z), Vector3.new(-1.6 * s, 0, z), 0.3 * s)
	end
	local neck = math.clamp(look.neck or 0.6, 0.2, 2.4)
	local neckDir = Vector3.new(1, neck * 0.9, 0).Unit
	local neckEnd = shoulder + neckDir * (0.8 + neck * 1.6) * s
	bone(b, shoulder, neckEnd, 0.3 * s)
	skull(b, neckEnd + Vector3.new(0.6 * s * (look.head or 1), 0, 0), s, look)

	local tail = (look.tail or 1) * s
	local tailMid = hip + Vector3.new(-1.3 * tail, -0.4 * s, 0)
	local tailEnd = hip + Vector3.new(-2.6 * tail, -1.0 * s, 0)
	bone(b, hip, tailMid, 0.3 * s)
	bone(b, tailMid, tailEnd, 0.18 * s)
	if look.club then
		ball(b, tailEnd, 0.8 * s)
	end
	if look.plates then
		local plateStart = hip:Lerp(tailMid, 0.5)
		for i = 0, 5 do
			local p = plateStart:Lerp(shoulder, i / 6)
			block(b, p + Vector3.new(0, 0.55 * s, 0), Vector3.new(0.7 * s, 0.7 * s, 0.12 * s), CFrame.Angles(0, 0, math.rad(45)))
		end
	end
	if look.sail then
		block(b, (shoulder + hip) / 2 + Vector3.new(0, 1.0 * s, 0), Vector3.new(3.0 * s, 1.6 * s, 0.1 * s))
	end
end

local function biped(b: Builder, s: number, look: Config.Look)
	local hip = Vector3.new(-0.3 * s, 3.0 * s, 0)
	local chest = hip + Vector3.new(1.6 * s, 0.6 * s, 0)
	bone(b, hip, chest, 0.42 * s)
	ribs(b, hip, chest, 4, 1.1 * s, 0.5 * s, 0.13 * s)
	for _, side in { -0.5, 0.5 } do
		local z = side * s
		local knee = hip + Vector3.new(0.6 * s, -1.5 * s, z)
		local ankle = Vector3.new(-0.3 * s, 0.4 * s, z)
		bone(b, hip + Vector3.new(0, 0, z), knee, 0.4 * s)
		bone(b, knee, ankle, 0.3 * s)
		bone(b, ankle, Vector3.new(0.4 * s, 0.05 * s, z), 0.22 * s)
		local shoulder = chest + Vector3.new(0, -0.3 * s, z * 0.8)
		bone(b, shoulder, shoulder + Vector3.new(0.4 * s, -0.7 * s, 0), 0.14 * s)
		bone(b, shoulder + Vector3.new(0.4 * s, -0.7 * s, 0), shoulder + Vector3.new(0.75 * s, -0.6 * s, 0), 0.11 * s)
	end
	local neckEnd = chest + Vector3.new(0.5 * s, 0.6 * s, 0)
	bone(b, chest, neckEnd, 0.3 * s)
	skull(b, neckEnd + Vector3.new(0.65 * s * (look.head or 1), 0.1 * s, 0), s, look)

	local tail = (look.tail or 1) * s
	local tailMid = hip + Vector3.new(-1.5 * tail, -0.15 * s, 0)
	local tailEnd = hip + Vector3.new(-3.0 * tail, -0.6 * s, 0)
	bone(b, hip, tailMid, 0.32 * s)
	bone(b, tailMid, tailEnd, 0.18 * s)
	if look.sail then
		block(b, (hip + chest) / 2 + Vector3.new(0, 1.0 * s, 0), Vector3.new(2.0 * s, 1.8 * s, 0.1 * s), CFrame.Angles(0, 0, math.rad(20)))
	end
end

local function flyer(b: Builder, s: number, look: Config.Look)
	stand(b, 2.8 * s)
	local back = Vector3.new(-0.8 * s, 3.0 * s, 0)
	local front = Vector3.new(0.8 * s, 3.25 * s, 0)
	bone(b, back, front, 0.5 * s)
	for _, side in { -1, 1 } do
		local root = front + Vector3.new(-0.3 * s, 0, side * 0.2 * s)
		local elbow = Vector3.new(0.3 * s, 3.9 * s, side * 1.8 * s)
		local tip = Vector3.new(-0.7 * s, 3.5 * s, side * 3.4 * s)
		bone(b, root, elbow, 0.22 * s)
		bone(b, elbow, tip, 0.16 * s)
		bone(b, tip, back + Vector3.new(-0.2 * s, 0, side * 0.3 * s), 0.08 * s)
		bone(b, elbow, back + Vector3.new(0, 0, side * 0.3 * s), 0.08 * s)
		bone(b, back + Vector3.new(0, 0, side * 0.25 * s), back + Vector3.new(-0.2 * s, -0.9 * s, side * 0.35 * s), 0.12 * s)
	end
	local neckEnd = front + Vector3.new(0.6 * s, 0.4 * s, 0)
	bone(b, front, neckEnd, 0.22 * s)
	local head = neckEnd + Vector3.new(0.7 * s, 0.05 * s, 0)
	block(b, head, Vector3.new(1.0, 0.5, 0.45) * s)
	block(b, head + Vector3.new(0.9 * s, -0.08 * s, 0), Vector3.new(1.2, 0.18, 0.2) * s) -- 부리
	if look.horns then
		bone(b, head + Vector3.new(-0.3 * s, 0.2 * s, 0), head + Vector3.new(-1.1 * s, 0.9 * s, 0), 0.14 * s)
	else
		bone(b, head + Vector3.new(-0.3 * s, 0.2 * s, 0), head + Vector3.new(-0.9 * s, 0.5 * s, 0), 0.12 * s)
	end
	bone(b, back, back + Vector3.new(-0.7 * s, -0.3 * s, 0), 0.1 * s)
end

local function swimmer(b: Builder, s: number, look: Config.Look)
	stand(b, 2.4 * s)
	local tailBase = Vector3.new(-1.9 * s, 2.6 * s, 0)
	local chest = Vector3.new(1.3 * s, 2.7 * s, 0)
	bone(b, tailBase, chest, 0.45 * s)
	ribs(b, tailBase:Lerp(chest, 0.15), chest, 5, 1.0 * s, 0.55 * s, 0.13 * s)
	local neck = (look.neck or 0.5) * s
	local neckEnd = chest + Vector3.new(0.4 * s + neck * 1.5, 0.1 * s, 0)
	bone(b, chest, neckEnd, 0.32 * s)
	skull(b, neckEnd + Vector3.new(0.6 * s * (look.head or 1), 0, 0), s, look)
	for _, side in { -1, 1 } do
		local f = chest + Vector3.new(-0.3 * s, -0.25 * s, side * 0.3 * s)
		bone(b, f, f + Vector3.new(0.5 * s, -0.5 * s, side * 1.4 * s), 0.2 * s)
		local r = tailBase + Vector3.new(0.7 * s, -0.25 * s, side * 0.3 * s)
		bone(b, r, r + Vector3.new(-0.3 * s, -0.4 * s, side * 1.2 * s), 0.18 * s)
	end
	local tailEnd = tailBase + Vector3.new(-1.4 * s, 0.05 * s, 0)
	bone(b, tailBase, tailEnd, 0.25 * s)
	bone(b, tailEnd, tailEnd + Vector3.new(-0.6 * s, 0.9 * s, 0), 0.16 * s)
	bone(b, tailEnd, tailEnd + Vector3.new(-0.6 * s, -0.7 * s, 0), 0.16 * s)
end

local BUILDERS = {
	Quadruped = quadruped,
	Biped = biped,
	Flyer = flyer,
	Swimmer = swimmer,
}

-- base: 전시대 윗면 중앙 CFrame
function FossilModel.Build(speciesId: string, base: CFrame): Model?
	local species = Config.SpeciesById[speciesId]
	if not species then
		return nil
	end
	local rarity = Config.RarityById[species.rarity]
	local model = Instance.new("Model")
	model.Name = species.id
	local b: Builder = { model = model, base = base, style = styleFor(species.rarity) }
	local s = species.look.scale or 1
	BUILDERS[species.shape](b, s, species.look)

	-- 이름표
	local anchor = Instance.new("Part")
	anchor.Name = "LabelAnchor"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.CFrame = base * CFrame.new(0, 6.2 * s, 0)
	anchor.Parent = model

	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(200, 50)
	gui.MaxDistance = 70
	gui.AlwaysOnTop = false
	gui.Parent = anchor
	local nameLabel = Instance.new("TextLabel")
	nameLabel.Size = UDim2.fromScale(1, 0.6)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Font = Enum.Font.FredokaOne
	nameLabel.TextScaled = true
	nameLabel.TextColor3 = rarity.color
	nameLabel.TextStrokeTransparency = 0.2
	nameLabel.Text = species.name
	nameLabel.Parent = gui
	local info = Instance.new("TextLabel")
	info.Size = UDim2.fromScale(1, 0.4)
	info.Position = UDim2.fromScale(0, 0.6)
	info.BackgroundTransparency = 1
	info.Font = Enum.Font.GothamBold
	info.TextScaled = true
	info.TextColor3 = Color3.new(1, 1, 1)
	info.TextStrokeTransparency = 0.3
	info.Text = string.format("%s · +%s/초", rarity.name, Util.FormatNumber(Economy.SpeciesIncome(species)))
	info.Parent = gui

	if rarity.tier >= 5 then
		local light = Instance.new("PointLight")
		light.Color = rarity.color
		light.Range = 10
		light.Brightness = 1.5
		light.Parent = anchor
		local sparkle = Instance.new("ParticleEmitter")
		sparkle.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		sparkle.Color = ColorSequence.new(rarity.color)
		sparkle.Size = NumberSequence.new(0.3)
		sparkle.Rate = 3
		sparkle.Lifetime = NumberRange.new(1, 2)
		sparkle.Speed = NumberRange.new(0.5, 1)
		sparkle.SpreadAngle = Vector2.new(180, 180)
		sparkle.Parent = anchor
	end

	return model
end

return FossilModel
]]></string></Properties></Item><Item class="ModuleScript" referent="RBX00000009"><Properties><string name="Name">HelperService</string><string name="Source"><![CDATA[-- 발굴 조수: 데리고 다니면 플레이어가 서 있는 지역에서 자동으로 흙더미를 팜
-- 조수 모형은 각 클라이언트가 플레이어의 "Helpers" 속성을 보고 그림 (서버 부담 없음)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Economy = require(ReplicatedStorage.Shared.Economy)
local DataService = require(script.Parent.DataService)
local Passes = require(script.Parent.Passes)
local Net = require(script.Parent.Net)
local Rewards = require(script.Parent.Rewards)
local Zones = require(script.Parent.Zones)

local HelperService = {}

local nextDig: { [Player]: { number } } = {}

local function activeHelpers(player: Player, data: any): { string }
	local slots = Economy.GetHelperSlots(Passes.Get(player))
	local list = {}
	for i, id in data.helpersEquipped do
		if i > slots then
			break
		end
		if Config.HelperById[id] then
			table.insert(list, id)
		end
	end
	return list
end

function HelperService.Refresh(player: Player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	player:SetAttribute("Helpers", table.concat(activeHelpers(player, data), ","))
end

local function tick()
	local now = os.clock()
	for _, player in Players:GetPlayers() do
		local data = DataService.Get(player)
		if data then
			local helpers = activeHelpers(player, data)
			if #helpers > 0 then
				local timers = nextDig[player]
				if not timers then
					timers = {}
					nextDig[player] = timers
				end
				local zoneId = Zones.PlayerZone(player)
				local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
				for i, id in helpers do
					local helper = Config.HelperById[id]
					if not timers[i] then
						timers[i] = now + helper.interval * (0.5 + math.random() * 0.5)
					elseif now >= timers[i] then
						timers[i] = now + helper.interval
						if zoneId and root and Zones.IsUnlocked(data, zoneId) then
							local kindId = if math.random() < 0.08 then "Sparkle" else "Dirt"
							local offset = Vector3.new(math.random(-4, 4), 2, math.random(-4, 4))
							Rewards.Dig(player, data, kindId, zoneId, root.Position + offset, { helper = true, helperName = helper.name })
						end
					end
				end
			end
		end
	end
end

function HelperService.Init()
	Net.Changed:Connect(HelperService.Refresh)
	Passes.Changed:Connect(HelperService.Refresh)
	DataService.Loaded:Connect(function(player)
		HelperService.Refresh(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		nextDig[player] = nil
	end)
	task.spawn(function()
		while true do
			task.wait(0.25)
			tick()
		end
	end)
end

return HelperService
]]></string></Properties></Item><Item class="ModuleScript" referent="RBX0000000A"><Properties><string name="Name">LeaderboardService</string><string name="Source"><![CDATA[-- 랭킹 보드: 완성 화석 수(전체 기간), 이번 주 받은 좋아요
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")

local DataService = require(script.Parent.DataService)

local LeaderboardService = {}

local UPDATE_INTERVAL = 90
local names: { [number]: string } = {}

local function nameOf(userId: number): string
	if names[userId] then
		return names[userId]
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	names[userId] = if ok then name else "???"
	return names[userId]
end

local function completed(data: any): number
	local total = 0
	for _, count in data.museum do
		total += count
	end
	return total
end

local function setBoard(board: BasePart, text: string)
	local gui = board:FindFirstChild("BoardGui")
	local list = gui and gui:FindFirstChild("List")
	if list and list:IsA("TextLabel") then
		list.Text = text
	end
end

local function refresh(board: BasePart, storeName: string, getValue: (any) -> number)
	local ok, store = pcall(function()
		return DataStoreService:GetOrderedDataStore(storeName)
	end)
	if not ok then
		setBoard(board, "게임을 게시하면 랭킹이 표시돼요")
		return
	end
	for _, player in Players:GetPlayers() do
		local data = DataService.Get(player)
		if data then
			local value = math.floor(getValue(data))
			if value > 0 then
				pcall(function()
					store:SetAsync(tostring(player.UserId), value)
				end)
			end
		end
	end
	local pageOk, page = pcall(function()
		return store:GetSortedAsync(false, 10):GetCurrentPage()
	end)
	if not pageOk then
		setBoard(board, "게임을 게시하면 랭킹이 표시돼요\n(Studio: API 서비스 사용 켜기)")
		return
	end
	local lines = {}
	for rank, entry in page do
		local medal = if rank == 1 then "🥇" elseif rank == 2 then "🥈" elseif rank == 3 then "🥉" else rank .. "."
		table.insert(lines, string.format("%s %s  -  %d", medal, nameOf(tonumber(entry.key) or 0), entry.value))
	end
	setBoard(board, if #lines > 0 then table.concat(lines, "\n") else "아직 기록이 없어요")
end

function LeaderboardService.Init(world: any)
	task.spawn(function()
		task.wait(10)
		while true do
			local week = DataService.Week()
			if world.boards.FossilBoard then
				refresh(world.boards.FossilBoard, "FossilsCompleted_v1", completed)
			end
			if world.boards.LikeBoard then
				refresh(world.boards.LikeBoard, "WeeklyLikes_" .. week, function(data)
					return if data.weekLikes.week == week then data.weekLikes.count else 0
				end)
			end
			task.wait(UPDATE_INTERVAL)
		end
	end)
end

return LeaderboardService
]]></string></Properties></Item><Item class="Script" referent="RBX0000000B"><Properties><string name="Name">Main</string><string name="Source"><![CDATA[-- 서버 시작점
local Server = script.Parent
local WorldBuilder = require(Server.WorldBuilder)
local DataService = require(Server.DataService)
local Passes = require(Server.Passes)
local Net = require(Server.Net)
local Zones = require(Server.Zones)
local DigService = require(Server.DigService)
local MuseumService = require(Server.MuseumService)
local ShopService = require(Server.ShopService)
local HelperService = require(Server.HelperService)
local TradeService = require(Server.TradeService)
local LeaderboardService = require(Server.LeaderboardService)
require(Server.QuestService) -- 버튼 요청 처리 등록

local world = WorldBuilder.Build()
Zones.Init(world)

Passes.Init()
Passes.Changed:Connect(function(player)
	Net.MarkDirty(player)
end)

-- 순서 중요: 데이터 로드 이벤트를 받는 서비스들을 먼저 연결하고, DataService 는 마지막에
MuseumService.Init(world)
DigService.Init(world)
HelperService.Init()
ShopService.Init()
TradeService.Init()
LeaderboardService.Init(world)
DataService.Init()

print("[FossilMuseum] 서버 준비 완료")
]]></string></Properties></Item><Item class="ModuleScript" referent="RBX0000000C"><Properties><string name="Name">MuseumService</string><string name="Source"><![CDATA[-- 박물관: 부지 배정, 화석 전시, 수입, 좋아요, 조립/판매
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Economy = require(ReplicatedStorage.Shared.Economy)
local Util = require(ReplicatedStorage.Shared.Util)
local DataService = require(script.Parent.DataService)
local Passes = require(script.Parent.Passes)
local Net = require(script.Parent.Net)
local FossilModel = require(script.Parent.FossilModel)
local QuestService = require(script.Parent.QuestService)
local Zones = require(script.Parent.Zones)

local MuseumService = {}

local world: any = nil
local playerPlot: { [Player]: Model } = {}
local signatures: { [Player]: string } = {}
local carry: { [Player]: number } = {}

local LOCKED_COLOR = Color3.fromRGB(120, 115, 110)
local OPEN_COLOR = Color3.fromRGB(200, 195, 185)

local function setText(part: Instance?, guiChildName: string, text: string)
	if not part then
		return
	end
	for _, gui in part:GetChildren() do
		if gui:IsA("SurfaceGui") then
			local label = gui:FindFirstChild(guiChildName)
			if label and label:IsA("TextLabel") then
				label.Text = text
			end
		end
	end
end

local function updateSign(plot: Model, player: Player?, data: any?)
	if player and data then
		setText(plot:FindFirstChild("Sign"), "Title", player.DisplayName .. "의 박물관")
		setText(plot:FindFirstChild("LikeStand"), "Likes", "❤️\n" .. Util.FormatNumber(data.likes))
	else
		setText(plot:FindFirstChild("Sign"), "Title", "빈 박물관")
		setText(plot:FindFirstChild("LikeStand"), "Likes", "❤️")
	end
end

local function clearDisplays(plot: Model)
	local displays = plot:FindFirstChild("Displays")
	if displays then
		displays:ClearAllChildren()
	end
end

local function refreshDisplay(player: Player)
	local plot = playerPlot[player]
	local data = DataService.Get(player)
	if not plot or not data then
		return
	end
	local list = Economy.GetDisplayed(data)
	local signature = data.slots .. "|" .. table.concat(list, ",")
	updateSign(plot, player, data)
	if signatures[player] == signature then
		return
	end
	signatures[player] = signature

	clearDisplays(plot)
	local pedestals = plot:FindFirstChild("Pedestals") :: Folder
	local displays = plot:FindFirstChild("Displays") :: Folder
	for i, ped in pedestals:GetChildren() do
		local index = tonumber(ped.Name) or i
		local p = ped :: BasePart
		local speciesId = list[index]
		if index > data.slots then
			p.Transparency = 0.7
			p.Color = LOCKED_COLOR
		elseif speciesId then
			p.Transparency = 0
			p.Color = Config.RarityById[Config.SpeciesById[speciesId].rarity].color
		else
			p.Transparency = 0
			p.Color = OPEN_COLOR
		end
		if speciesId and index <= data.slots then
			local base = p.CFrame * CFrame.new(0, p.Size.Y / 2, 0)
			local model = FossilModel.Build(speciesId, base)
			if model then
				model.Parent = displays
			end
		end
	end
end

local function assignPlot(player: Player)
	for _, plot in world.plots do
		if plot:GetAttribute("OwnerUserId") == 0 then
			plot:SetAttribute("OwnerUserId", player.UserId)
			playerPlot[player] = plot
			signatures[player] = nil
			refreshDisplay(player)
			return
		end
	end
	Net.Tell(player, "빈 박물관 부지가 없어요. 서버 최대 인원을 8명으로 설정해 주세요.")
end

local function releasePlot(player: Player)
	local plot = playerPlot[player]
	if plot then
		clearDisplays(plot)
		updateSign(plot)
		plot:SetAttribute("OwnerUserId", 0)
		local pedestals = plot:FindFirstChild("Pedestals")
		if pedestals then
			for _, ped in pedestals:GetChildren() do
				(ped :: BasePart).Transparency = 0.6;
				(ped :: BasePart).Color = OPEN_COLOR
			end
		end
	end
	playerPlot[player] = nil
	signatures[player] = nil
	carry[player] = nil
end

local function countCompleted(data: any): number
	local total = 0
	for _, count in data.museum do
		total += count
	end
	return total
end

local function setupLeaderstats(player: Player, data: any)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local coins = Instance.new("IntValue")
	coins.Name = "코인"
	coins.Value = math.floor(data.coins)
	coins.Parent = stats
	local fossils = Instance.new("IntValue")
	fossils.Name = "화석"
	fossils.Value = countCompleted(data)
	fossils.Parent = stats
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "환생"
	rebirths.Value = data.rebirths
	rebirths.Parent = stats
	stats.Parent = player
end

----------------------------------------------------------------------
-- 좋아요
----------------------------------------------------------------------
local function onLike(liker: Player, plot: Model)
	local ownerId = plot:GetAttribute("OwnerUserId") :: number
	if not ownerId or ownerId == 0 then
		return
	end
	if ownerId == liker.UserId then
		Net.Tell(liker, "내 박물관에는 좋아요를 누를 수 없어요 😅")
		return
	end
	local owner = Players:GetPlayerByUserId(ownerId)
	local likerData = DataService.Get(liker)
	local ownerData = owner and DataService.Get(owner)
	if not owner or not likerData or not ownerData then
		return
	end
	local key = tostring(ownerId)
	local today = DataService.Today()
	if likerData.likedGiven[key] == today then
		Net.Tell(liker, "오늘은 이미 이 박물관에 좋아요를 눌렀어요. 내일 또 와주세요!")
		return
	end
	likerData.likedGiven[key] = today
	ownerData.likes += 1
	local week = DataService.Week()
	if ownerData.weekLikes.week ~= week then
		ownerData.weekLikes = { week = week, count = 0 }
	end
	ownerData.weekLikes.count += 1
	QuestService.Progress(liker, "Like")
	Net.Tell(liker, owner.DisplayName .. "님의 박물관에 좋아요를 눌렀어요 ❤️", Color3.fromRGB(255, 130, 160))
	Net.Tell(owner, liker.DisplayName .. "님이 내 박물관에 좋아요를 눌렀어요! ❤️ (수입 +1%)", Color3.fromRGB(255, 130, 160))
	Net.MarkDirty(owner)
end

----------------------------------------------------------------------
-- 버튼 요청
----------------------------------------------------------------------
Net.Handle("Assemble", function(player, speciesId)
	local data = DataService.Get(player)
	if type(speciesId) ~= "string" or not Economy.HasAllPieces(data, speciesId) then
		return false, "조각이 모자라요"
	end
	local species = Config.SpeciesById[speciesId]
	local owned = data.pieces[speciesId]
	for i = 1, #Config.GetPieces(species) do
		local key = tostring(i)
		owned[key] -= 1
		if owned[key] <= 0 then
			owned[key] = nil
		end
	end
	data.museum[speciesId] = (data.museum[speciesId] or 0) + 1
	QuestService.Progress(player, "Assemble")
	local rarity = Config.RarityById[species.rarity]
	if rarity.tier >= Config.AnnounceTier then
		Net.Announce(string.format("🏛️ %s님이 [%s] %s 화석을 완성했어요!", player.DisplayName, rarity.name, species.name), rarity.color)
	end
	Net.MarkDirty(player)
	return true, species.name .. " 화석 완성! 박물관에 전시했어요 🦖"
end)

Net.Handle("SellDuplicates", function(player)
	local data = DataService.Get(player)
	local value = Economy.GetDuplicateValue(data)
	if value <= 0 then
		return false, "판매할 중복 조각이 없어요"
	end
	for _, owned in data.pieces do
		for key, count in owned do
			if count > 1 then
				owned[key] = 1
			end
		end
	end
	data.coins += value
	Net.MarkDirty(player)
	return true, "중복 조각을 팔아서 " .. Util.FormatNumber(value) .. " 코인을 받았어요"
end)

Net.Handle("Teleport", function(player, target)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return false, nil
	end
	if target == "Museum" then
		local plot = playerPlot[player]
		local entry = plot and plot:FindFirstChild("Entry") :: BasePart?
		if not entry then
			return false, "박물관이 없어요"
		end
		-- 입구에서 안쪽(전시대 방향)을 바라보도록
		root.CFrame = entry.CFrame * CFrame.Angles(0, math.pi, 0) + Vector3.new(0, 2, 0)
		return true, nil
	elseif type(target) == "string" and Config.ZoneById[target] then
		local data = DataService.Get(player)
		local zone = Zones.Get(target)
		if not Zones.IsUnlocked(data, target) then
			return false, "🔒 먼저 지역을 열어야 해요"
		end
		root.CFrame = zone.spawn
		return true, nil
	end
	return false, nil
end)

----------------------------------------------------------------------
function MuseumService.Init(builtWorld: any)
	world = builtWorld

	for _, plot in world.plots do
		local stand = plot:FindFirstChild("LikeStand")
		local prompt = stand and stand:FindFirstChild("LikePrompt") :: ProximityPrompt?
		if prompt then
			prompt.Triggered:Connect(function(liker)
				onLike(liker, plot)
			end)
		end
	end

	DataService.Loaded:Connect(function(player: Player, data: any, offlineSeconds: number)
		QuestService.OnLoaded(player, data)
		setupLeaderstats(player, data)
		assignPlot(player)
		if offlineSeconds > 60 then
			local earned = math.floor(Economy.GetIncome(data, Passes.Get(player)) * Config.OfflineRate * offlineSeconds)
			if earned > 0 then
				data.coins += earned
				data.stats.totalEarned += earned
				task.delay(3, function()
					if player.Parent then
						Net.Notify:FireClient(player, { kind = "Offline", coins = earned, seconds = offlineSeconds })
					end
				end)
			end
		end
		Net.MarkDirty(player)
	end)

	Net.Changed:Connect(function(player: Player)
		refreshDisplay(player)
		local data = DataService.Get(player)
		local stats = player:FindFirstChild("leaderstats")
		local fossils = stats and stats:FindFirstChild("화석") :: IntValue?
		if data and fossils then
			fossils.Value = countCompleted(data)
		end
		local rebirths = stats and stats:FindFirstChild("환생") :: IntValue?
		if data and rebirths then
			rebirths.Value = data.rebirths
		end
	end)

	Players.PlayerRemoving:Connect(releasePlot)

	-- 박물관 수입 (1초마다)
	task.spawn(function()
		while true do
			task.wait(1)
			for player, _ in playerPlot do
				local data = DataService.Get(player)
				if data then
					local income = Economy.GetIncome(data, Passes.Get(player))
					local total = (carry[player] or 0) + income
					local whole = math.floor(total)
					carry[player] = total - whole
					if whole > 0 then
						data.coins += whole
						data.stats.totalEarned += whole
						Net.UpdateCoins(player)
					end
				end
			end
		end
	end)
end

return MuseumService
]]></string></Properties></Item><Item class="ModuleScript" referent="RBX0000000D"><Properties><string name="Name">Net</string><string name="Source"><![CDATA[-- 클라이언트와 통신: 리모트 생성, 알림, 데이터 동기화
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Economy = require(ReplicatedStorage.Shared.Economy)
local DataService = require(script.Parent.DataService)
local Passes = require(script.Parent.Passes)

local Net = {}

local folder = Instance.new("Folder")
folder.Name = "Remotes"

local function make(className: string, name: string): any
	local remote = Instance.new(className)
	remote.Name = name
	remote.Parent = folder
	return remote
end

Net.Dig = make("RemoteEvent", "Dig") :: RemoteEvent -- 클라 → 서버: 흙더미 파기
Net.Notify = make("RemoteEvent", "Notify") :: RemoteEvent -- 서버 → 클라: 알림
Net.Sync = make("RemoteEvent", "Sync") :: RemoteEvent -- 서버 → 클라: 데이터 전체
Net.Effect = make("RemoteEvent", "Effect") :: RemoteEvent -- 서버 → 클라: 연출
Net.Action = make("RemoteFunction", "Action") :: RemoteFunction -- 클라 → 서버: 버튼 요청
Net.Trade = make("RemoteEvent", "Trade") :: RemoteEvent -- 서버 → 클라: 거래 상태

folder.Parent = ReplicatedStorage

local changedEvent = Instance.new("BindableEvent")
Net.Changed = changedEvent.Event -- (player) 데이터 구조가 바뀜 (조각, 전시 등)

local handlers: { [string]: (Player, ...any) -> any } = {}
local lastCalls: { [Player]: { number } } = {}

-- 버튼 요청 처리 함수 등록. 반환값: (성공 여부, 메시지)
function Net.Handle(action: string, fn: (Player, ...any) -> any)
	handlers[action] = fn
end

Net.Action.OnServerInvoke = function(player: Player, action: any, ...: any)
	if type(action) ~= "string" or not handlers[action] then
		return false, "알 수 없는 요청"
	end
	-- 초당 10회 제한
	local now = os.clock()
	local calls = lastCalls[player] or {}
	lastCalls[player] = calls
	while calls[1] and now - calls[1] > 1 do
		table.remove(calls, 1)
	end
	if #calls >= 10 then
		return false, "너무 빨라요!"
	end
	table.insert(calls, now)

	if not DataService.Get(player) then
		return false, "데이터를 불러오는 중이에요"
	end
	local ok, success, message = pcall(handlers[action], player, ...)
	if not ok then
		warn("[Net] " .. action .. " 오류:", success)
		return false, "오류가 발생했어요"
	end
	return success, message
end

Players.PlayerRemoving:Connect(function(player)
	lastCalls[player] = nil
end)

function Net.Snapshot(player: Player): any?
	local data = DataService.Get(player)
	if not data then
		return nil
	end
	local passes = Passes.Get(player)
	return {
		coins = data.coins,
		tool = data.tool,
		ownedTools = data.ownedTools,
		pieces = data.pieces,
		museum = data.museum,
		slots = data.slots,
		likes = data.likes,
		luckBoostUntil = data.luckBoostUntil,
		stats = data.stats,
		unlockedZones = data.unlockedZones,
		rebirths = data.rebirths,
		helpersOwned = data.helpersOwned,
		helpersEquipped = data.helpersEquipped,
		daily = data.daily,
		quests = data.quests,
		autoDig = data.autoDig,
		passes = passes,
		income = Economy.GetIncome(data, passes),
		luck = Economy.GetLuck(data, passes, 0),
		cooldown = Economy.GetDigCooldown(data, passes),
		helperSlots = Economy.GetHelperSlots(passes),
		rebirthPrice = Economy.GetRebirthPrice(data),
		today = os.time() // 86400,
	}
end

-- 코인 숫자만 빠르게 갱신 (자주 호출해도 됨)
function Net.UpdateCoins(player: Player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	player:SetAttribute("Coins", data.coins)
	local stats = player:FindFirstChild("leaderstats")
	local coinsValue = stats and stats:FindFirstChild("코인")
	if coinsValue then
		(coinsValue :: IntValue).Value = math.floor(data.coins)
	end
end

-- 데이터 구조가 바뀌었을 때 호출 → 잠시 후 한 번에 전송
local pending: { [Player]: boolean } = {}
function Net.MarkDirty(player: Player)
	Net.UpdateCoins(player)
	if pending[player] then
		return
	end
	pending[player] = true
	task.defer(function()
		pending[player] = nil
		if player.Parent then
			local snapshot = Net.Snapshot(player)
			if snapshot then
				Net.Sync:FireClient(player, snapshot)
				changedEvent:Fire(player)
			end
		end
	end)
end

function Net.Tell(player: Player, text: string, color: Color3?)
	Net.Notify:FireClient(player, { kind = "Text", text = text, color = color })
end

function Net.Announce(text: string, color: Color3?)
	Net.Notify:FireAllClients({ kind = "Announce", text = text, color = color })
end

Net.Handle("GetSnapshot", function(player)
	return true, Net.Snapshot(player)
end)

return Net
]]></string></Properties></Item><Item class="ModuleScript" referent="RBX0000000E"><Properties><string name="Name">Passes</string><string name="Source"><![CDATA[-- 게임 패스 보유 여부 (접속 시 확인하고 기억)
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local Passes = {}

local owned: { [Player]: { [string]: boolean } } = {}
local changedEvent = Instance.new("BindableEvent")
Passes.Changed = changedEvent.Event -- (player)

local function defaults(): { [string]: boolean }
	return { DoubleSpeed = false, DoubleLuck = false, DoubleIncome = false, AutoDig = false, ExtraHelpers = false }
end

local function check(player: Player)
	local result = defaults()
	for key, pass in Config.GamePasses do
		if pass.id ~= 0 then
			local ok, has = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.id)
			end)
			result[key] = ok and has == true
		end
	end
	owned[player] = result
	changedEvent:Fire(player)
end

function Passes.Get(player: Player): any
	return owned[player] or defaults()
end

function Passes.Init()
	Players.PlayerAdded:Connect(check)
	for _, player in Players:GetPlayers() do
		task.spawn(check, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		owned[player] = nil
	end)

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		for key, pass in Config.GamePasses do
			if pass.id == passId then
				local current = owned[player]
				if current then
					current[key] = true
				end
				changedEvent:Fire(player)
			end
		end
	end)
end

return Passes
]]></string></Properties></Item><Item class="ModuleScript" referent="RBX0000000F"><Properties><string name="Name">QuestService</string><string name="Source"><![CDATA[-- 일일 퀘스트 + 매일 접속 보상
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Economy = require(ReplicatedStorage.Shared.Economy)
local Util = require(ReplicatedStorage.Shared.Util)
local DataService = require(script.Parent.DataService)
local Passes = require(script.Parent.Passes)
local Net = require(script.Parent.Net)

local QuestService = {}

-- 오늘의 퀘스트가 없으면 새로 만듦 (날짜 + UserId 로 정해짐)
local function ensureQuests(player: Player, data: any): boolean
	local today = DataService.Today()
	if data.quests.day == today and #data.quests.list > 0 then
		return false
	end
	local rng = Random.new(today * 1000003 + player.UserId % 1000003)
	local pool = {}
	for i = 1, #Config.QuestTemplates do
		table.insert(pool, i)
	end
	local list = {}
	for slot = 1, 3 do
		local pick = table.remove(pool, rng:NextInteger(1, #pool))
		local template = Config.QuestTemplates[pick]
		local tier = slot -- 쉬움, 보통, 어려움 하나씩
		table.insert(list, {
			type = template.type,
			tier = tier,
			target = template.amounts[tier],
			progress = 0,
			claimed = false,
		})
	end
	data.quests = { day = today, list = list, bonusClaimed = false }
	return true
end

function QuestService.Progress(player: Player, questType: string, amount: number?)
	local data = DataService.Get(player)
	if not data then
		return
	end
	ensureQuests(player, data)
	local completed = false
	for _, quest in data.quests.list do
		if quest.type == questType and quest.progress < quest.target then
			quest.progress = math.min(quest.target, quest.progress + (amount or 1))
			if quest.progress >= quest.target then
				completed = true
				Net.Tell(player, "📜 퀘스트 완료! 퀘스트 창에서 보상을 받으세요", Color3.fromRGB(140, 255, 140))
			end
		end
	end
	-- 진행도만 바뀌었을 때는 전송하지 않음 (퀘스트 창을 열면 새로 받아감)
	if completed then
		Net.MarkDirty(player)
	end
end

local function rewardFor(player: Player, data: any, tier: number): number
	local income = Economy.GetIncome(data, Passes.Get(player))
	return math.max(Config.QuestMinReward[tier], math.floor(income * Config.QuestRewardSeconds[tier]))
end

function QuestService.RewardFor(player: Player, data: any, tier: number): number
	return rewardFor(player, data, tier)
end

local function addCoins(data: any, coins: number)
	data.coins += coins
	data.stats.totalEarned += coins
end

Net.Handle("ClaimQuest", function(player, index)
	local data = DataService.Get(player)
	ensureQuests(player, data)
	local quest = type(index) == "number" and data.quests.list[index]
	if not quest then
		return false, "없는 퀘스트예요"
	end
	if quest.claimed then
		return false, "이미 받았어요"
	end
	if quest.progress < quest.target then
		return false, "아직 완료하지 않았어요"
	end
	quest.claimed = true
	local coins = rewardFor(player, data, quest.tier)
	addCoins(data, coins)
	local message = "📜 퀘스트 보상 💰 " .. Util.FormatNumber(coins)

	local allDone = true
	for _, q in data.quests.list do
		if not q.claimed then
			allDone = false
		end
	end
	if allDone and not data.quests.bonusClaimed then
		data.quests.bonusClaimed = true
		data.luckBoostUntil = math.max(data.luckBoostUntil, os.time()) + Config.QuestAllDoneLuckMinutes * 60
		message ..= string.format(" + 🍀 행운 부스트 %d분!", Config.QuestAllDoneLuckMinutes)
	end
	Net.MarkDirty(player)
	return true, message
end)

----------------------------------------------------------------------
-- 매일 접속 보상
----------------------------------------------------------------------
function QuestService.DailyState(data: any): (boolean, number)
	local today = DataService.Today()
	local canClaim = data.daily.last ~= today
	local nextStreak = if data.daily.last == today - 1 then data.daily.streak + 1 else 1
	if not canClaim then
		nextStreak = data.daily.streak
	end
	return canClaim, ((nextStreak - 1) % #Config.DailyRewards) + 1
end

Net.Handle("ClaimDaily", function(player)
	local data = DataService.Get(player)
	local today = DataService.Today()
	if data.daily.last == today then
		return false, "오늘 보상은 이미 받았어요. 내일 또 와요!"
	end
	local streak = if data.daily.last == today - 1 then data.daily.streak + 1 else 1
	data.daily.last = today
	data.daily.streak = streak
	local day = ((streak - 1) % #Config.DailyRewards) + 1
	local reward = Config.DailyRewards[day]
	local income = Economy.GetIncome(data, Passes.Get(player))
	local coins = math.max(reward.minCoins, math.floor(income * reward.coinsSeconds))
	addCoins(data, coins)
	local message = string.format("🎁 %d일차 보상 💰 %s", day, Util.FormatNumber(coins))
	if reward.luckMinutes then
		data.luckBoostUntil = math.max(data.luckBoostUntil, os.time()) + reward.luckMinutes * 60
		message ..= string.format(" + 🍀 행운 부스트 %d분", reward.luckMinutes)
	end
	Net.MarkDirty(player)
	return true, message
end)

Net.Handle("GetQuestRewards", function(player)
	local data = DataService.Get(player)
	if ensureQuests(player, data) then
		Net.MarkDirty(player)
	end
	local rewards = {}
	for i, quest in data.quests.list do
		rewards[i] = rewardFor(player, data, quest.tier)
	end
	local _, day = QuestService.DailyState(data)
	local reward = Config.DailyRewards[day]
	local income = Economy.GetIncome(data, Passes.Get(player))
	return true, { quests = rewards, daily = math.max(reward.minCoins, math.floor(income * reward.coinsSeconds)), dailyDay = day }
end)

function QuestService.OnLoaded(player: Player, data: any)
	ensureQuests(player, data)
end

return QuestService
]]></string></Properties></Item><Item class="ModuleScript" referent="RBX00000010"><Properties><string name="Name">Rewards</string><string name="Source"><![CDATA[-- 흙더미를 부쉈을 때 보상 (플레이어 삽질 + 조수 자동 발굴 공통)
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Economy = require(ReplicatedStorage.Shared.Economy)
local Passes = require(script.Parent.Passes)
local Net = require(script.Parent.Net)
local QuestService = require(script.Parent.QuestService)

local Rewards = {}

export type Options = {
	helper: boolean?,
	helperName: string?,
}

function Rewards.Dig(player: Player, data: any, kindId: string, zoneId: string, position: Vector3, options: Options?)
	local opts = options or {}
	local kind = Config.Mounds[kindId] or Config.Mounds.Dirt
	local zone = Config.ZoneById[zoneId] or Config.Zones[1]
	local passes = Passes.Get(player)
	local tool = Config.ToolsById[data.tool] or Config.Tools[1]

	local coins = math.floor(kind.coins * zone.coinMult * (1 + tool.power * 0.1) * Economy.GetCoinMultiplier(data))
	data.coins += coins
	data.stats.totalEarned += coins

	if opts.helper then
		data.stats.helperDug += 1
		QuestService.Progress(player, "HelperDig")
	else
		data.stats.dug += 1
		QuestService.Progress(player, "Dig")
	end
	if kindId == "Meteor" then
		data.stats.meteors += 1
		QuestService.Progress(player, "Meteor")
	end

	local result: { [string]: any } = { kind = "Dig", coins = coins, position = position, helper = opts.helper == true }
	local pieceChance = kind.pieceChance * (if opts.helper then Config.HelperPieceChance else 1)
	local foundPiece = false

	if math.random() < pieceChance then
		foundPiece = true
		local luck = Economy.GetLuck(data, passes, kind.luck)
		local speciesId, pieceIndex = Economy.RollPiece(luck, kind.cosmicChance, zone.id)
		local owned = data.pieces[speciesId]
		if not owned then
			owned = {}
			data.pieces[speciesId] = owned
		end
		local key = tostring(pieceIndex)
		local before = owned[key] or 0
		owned[key] = before + 1
		data.stats.found += 1

		result.speciesId = speciesId
		result.pieceIndex = pieceIndex
		result.isNew = before == 0
		result.complete = Economy.HasAllPieces(data, speciesId)

		local species = Config.SpeciesById[speciesId]
		local rarity = Config.RarityById[species.rarity]
		QuestService.Progress(player, "Find")
		if rarity.tier >= 3 then
			QuestService.Progress(player, "FindRare")
		end
		if rarity.tier >= Config.AnnounceTier then
			local pieceName = Config.GetPieces(species)[pieceIndex]
			local who = if opts.helper then string.format("%s님의 조수 %s(이)가", player.DisplayName, opts.helperName or "") else player.DisplayName .. "님이"
			Net.Announce(string.format("🦴 %s [%s] %s %s 조각을 발견했어요!", who, rarity.name, species.name, pieceName), rarity.color)
		end
	end

	Net.Notify:FireClient(player, result)
	if foundPiece or kindId == "Meteor" then
		Net.MarkDirty(player)
	else
		Net.UpdateCoins(player)
	end
end

return Rewards
]]></string></Properties></Item><Item class="ModuleScript" referent="RBX00000011"><Properties><string name="Name">ShopService</string><string name="Source"><![CDATA[-- 상점: 코인으로 도구/전시대 구매, Robux 개발자 상품 처리
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Economy = require(ReplicatedStorage.Shared.Economy)
local Util = require(ReplicatedStorage.Shared.Util)
local DataService = require(script.Parent.DataService)
local Passes = require(script.Parent.Passes)
local Net = require(script.Parent.Net)
local DigService = require(script.Parent.DigService)
local Zones = require(script.Parent.Zones)

local ShopService = {}

local MAX_RECEIPTS = 50

Net.Handle("BuyTool", function(player, toolId)
	local data = DataService.Get(player)
	local def = type(toolId) == "string" and Config.ToolsById[toolId]
	if not def then
		return false, "없는 도구예요"
	end
	if data.ownedTools[def.id] then
		return false, "이미 가지고 있어요"
	end
	if data.coins < def.price then
		return false, "코인이 " .. Util.FormatNumber(def.price - data.coins) .. " 부족해요"
	end
	data.coins -= def.price
	data.ownedTools[def.id] = true
	data.tool = def.id
	DigService.GiveTool(player)
	Net.MarkDirty(player)
	return true, def.name .. " 구매 완료! ⛏️"
end)

Net.Handle("EquipTool", function(player, toolId)
	local data = DataService.Get(player)
	if type(toolId) ~= "string" or not data.ownedTools[toolId] or not Config.ToolsById[toolId] then
		return false, "가지고 있지 않은 도구예요"
	end
	data.tool = toolId
	DigService.GiveTool(player)
	Net.MarkDirty(player)
	return true, nil
end)

Net.Handle("BuySlot", function(player)
	local data = DataService.Get(player)
	local price = Economy.GetNextSlotPrice(data)
	if not price then
		return false, "전시대를 모두 열었어요"
	end
	if data.coins < price then
		return false, "코인이 " .. Util.FormatNumber(price - data.coins) .. " 부족해요"
	end
	data.coins -= price
	data.slots = math.min(data.slots + Config.SlotStep, Config.MaxSlots)
	Net.MarkDirty(player)
	return true, "전시대 확장! 이제 " .. data.slots .. "개를 전시할 수 있어요"
end)

----------------------------------------------------------------------
-- 발굴 지역 열기
----------------------------------------------------------------------
Net.Handle("BuyZone", function(player, zoneId)
	local data = DataService.Get(player)
	local zone = type(zoneId) == "string" and Config.ZoneById[zoneId]
	if not zone then
		return false, "없는 지역이에요"
	end
	if data.unlockedZones[zone.id] then
		return false, "이미 열린 지역이에요"
	end
	-- 앞 지역부터 차례로 열어야 함
	local index = (zone :: any).index
	local previous = Config.Zones[index - 1]
	if previous and not data.unlockedZones[previous.id] then
		return false, previous.name .. "을(를) 먼저 열어야 해요"
	end
	if data.coins < zone.price then
		return false, "코인이 " .. Util.FormatNumber(zone.price - data.coins) .. " 부족해요"
	end
	data.coins -= zone.price
	data.unlockedZones[zone.id] = true
	Net.MarkDirty(player)
	Net.Announce(string.format("%s %s님이 %s을(를) 열었어요!", zone.emoji, player.DisplayName, zone.name), Color3.fromRGB(255, 230, 150))
	return true, zone.emoji .. " " .. zone.name .. " 열림! 🗺️ 지역 메뉴에서 이동할 수 있어요"
end)

----------------------------------------------------------------------
-- 발굴 조수
----------------------------------------------------------------------
Net.Handle("BuyHelper", function(player, helperId)
	local data = DataService.Get(player)
	local helper = type(helperId) == "string" and Config.HelperById[helperId]
	if not helper then
		return false, "없는 조수예요"
	end
	if data.coins < helper.price then
		return false, "코인이 " .. Util.FormatNumber(helper.price - data.coins) .. " 부족해요"
	end
	data.coins -= helper.price
	data.helpersOwned[helper.id] = (data.helpersOwned[helper.id] or 0) + 1
	-- 빈 칸이 있으면 바로 데리고 다님
	if #data.helpersEquipped < Economy.GetHelperSlots(Passes.Get(player)) then
		table.insert(data.helpersEquipped, helper.id)
	end
	Net.MarkDirty(player)
	return true, "🦖 " .. helper.name .. " 고용 완료!"
end)

Net.Handle("EquipHelper", function(player, helperId)
	local data = DataService.Get(player)
	local helper = type(helperId) == "string" and Config.HelperById[helperId]
	if not helper then
		return false, "없는 조수예요"
	end
	if Economy.CountEquipped(data, helper.id) >= (data.helpersOwned[helper.id] or 0) then
		return false, "데리고 다닐 수 있는 " .. helper.name .. "이(가) 없어요"
	end
	if #data.helpersEquipped >= Economy.GetHelperSlots(Passes.Get(player)) then
		return false, "조수 칸이 가득 찼어요"
	end
	table.insert(data.helpersEquipped, helper.id)
	Net.MarkDirty(player)
	return true, nil
end)

Net.Handle("UnequipHelper", function(player, helperId)
	local data = DataService.Get(player)
	local index = type(helperId) == "string" and table.find(data.helpersEquipped, helperId)
	if not index then
		return false, nil
	end
	table.remove(data.helpersEquipped, index)
	Net.MarkDirty(player)
	return true, nil
end)

----------------------------------------------------------------------
-- 환생
----------------------------------------------------------------------
Net.Handle("Rebirth", function(player)
	local data = DataService.Get(player)
	local price = Economy.GetRebirthPrice(data)
	if data.coins < price then
		return false, "환생하려면 코인이 " .. Util.FormatNumber(price - data.coins) .. " 더 필요해요"
	end
	data.rebirths += 1
	data.coins = 0
	data.tool = "WoodShovel"
	data.ownedTools = { WoodShovel = true }
	data.unlockedZones = { Desert = true }
	data.slots = Config.StartSlots
	DigService.GiveTool(player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local desert = Zones.Get("Desert")
	if root and desert then
		root.CFrame = desert.spawn
	end
	Net.MarkDirty(player)
	Net.Announce(string.format("🔁 %s님이 %d번째 환생을 했어요!", player.DisplayName, data.rebirths), Color3.fromRGB(255, 160, 255))
	return true, string.format("🔁 환생 완료! 수입 +%d%%, 코인 +%d%%, 행운 +%d%%", math.floor(data.rebirths * Config.Rebirth.incomeBonus * 100), math.floor(data.rebirths * Config.Rebirth.coinBonus * 100), math.floor(data.rebirths * Config.Rebirth.luckBonus * 100 + 0.5))
end)

Net.Handle("ToggleAutoDig", function(player)
	local data = DataService.Get(player)
	data.autoDig = not data.autoDig
	Net.MarkDirty(player)
	return true, if data.autoDig then "🤖 자동 발굴 켜짐" else "🤖 자동 발굴 꺼짐"
end)

----------------------------------------------------------------------
-- Robux 개발자 상품
----------------------------------------------------------------------
local function grantProduct(player: Player, data: any, productId: number): boolean
	for key, product in Config.Products do
		if product.id == productId and product.id ~= 0 then
			if key == "LuckBoost" then
				local start = math.max(data.luckBoostUntil, os.time())
				data.luckBoostUntil = start + (product.minutes or 15) * 60
				Net.Tell(player, "🍀 행운 부스트가 켜졌어요!", Color3.fromRGB(120, 255, 120))
			elseif key == "ServerLuck" then
				local current = ReplicatedStorage:GetAttribute("ServerLuckUntil")
				local start = math.max(if type(current) == "number" then current else 0, os.time())
				ReplicatedStorage:SetAttribute("ServerLuckUntil", start + (product.minutes or 15) * 60)
				Net.Announce(string.format("🌟 %s님 덕분에 %d분 동안 서버 전체 행운 2배!", player.DisplayName, product.minutes or 15), Color3.fromRGB(255, 235, 120))
			else
				local income = Economy.GetIncome(data, Passes.Get(player))
				local coins = math.max(product.minCoins or 0, math.floor(income * (product.coinsSeconds or 0)))
				data.coins += coins
				data.stats.totalEarned += coins
				Net.Tell(player, "💰 " .. Util.FormatNumber(coins) .. " 코인을 받았어요! 감사합니다!", Color3.fromRGB(255, 220, 90))
			end
			return true
		end
	end
	return false
end

local function processReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = DataService.Get(player)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if table.find(data.purchases, receipt.PurchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	if not grantProduct(player, data, receipt.ProductId) then
		warn("[ShopService] 알 수 없는 상품 ID:", receipt.ProductId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	table.insert(data.purchases, receipt.PurchaseId)
	while #data.purchases > MAX_RECEIPTS do
		table.remove(data.purchases, 1)
	end
	Net.MarkDirty(player)
	-- 바로 저장해서 서버가 꺼져도 지급 기록이 남도록
	DataService.Save(player)
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function ShopService.Init()
	MarketplaceService.ProcessReceipt = processReceipt
end

return ShopService
]]></string></Properties></Item><Item class="ModuleScript" referent="RBX00000012"><Properties><string name="Name">TradeService</string><string name="Source"><![CDATA[-- 플레이어끼리 화석 조각 / 코인 거래
-- 흐름: 요청 → 수락 → 양쪽이 물건 올리기 → 둘 다 "준비" → 서버가 한 번에 교환
-- 사기 방지: 내용이 바뀌면 준비가 풀리고, 바뀐 뒤 3초 동안은 준비를 누를 수 없음
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local DataService = require(script.Parent.DataService)
local Net = require(script.Parent.Net)

local TradeService = {}

local READY_LOCK = 3

type Offer = { items: { [string]: number }, coins: number }
type Trade = {
	players: { Player },
	offers: { [Player]: Offer },
	ready: { [Player]: boolean },
	changedAt: number,
}

local trades: { [Player]: Trade } = {}
local requests: { [Player]: { from: Player, at: number } } = {} -- [받는 사람]
local lastRequest: { [Player]: number } = {}

local function itemKey(speciesId: string, pieceIndex: number): string
	return speciesId .. "|" .. pieceIndex
end

local function parseKey(key: string): (string, number)
	local speciesId, index = key:match("^(.+)|(%d+)$")
	return speciesId :: string, tonumber(index) :: number
end

local function other(trade: Trade, player: Player): Player
	return if trade.players[1] == player then trade.players[2] else trade.players[1]
end

local function offerList(offer: Offer): { any }
	local list = {}
	for key, count in offer.items do
		local speciesId, pieceIndex = parseKey(key)
		table.insert(list, { speciesId = speciesId, pieceIndex = pieceIndex, count = count })
	end
	table.sort(list, function(a, b)
		return a.speciesId .. a.pieceIndex < b.speciesId .. b.pieceIndex
	end)
	return list
end

local function sendState(trade: Trade)
	for _, player in trade.players do
		local them = other(trade, player)
		Net.Trade:FireClient(player, {
			type = "State",
			me = { items = offerList(trade.offers[player]), coins = trade.offers[player].coins, ready = trade.ready[player] == true },
			them = { name = them.DisplayName, items = offerList(trade.offers[them]), coins = trade.offers[them].coins, ready = trade.ready[them] == true },
			lockLeft = math.max(0, trade.changedAt + READY_LOCK - os.clock()),
		})
	end
end

local function close(trade: Trade, reason: string)
	for _, player in trade.players do
		trades[player] = nil
		if player.Parent then
			Net.Trade:FireClient(player, { type = "Closed", reason = reason })
		end
	end
end

local function owns(data: any, speciesId: string, pieceIndex: number, count: number): boolean
	local owned = data.pieces[speciesId]
	return owned ~= nil and (owned[tostring(pieceIndex)] or 0) >= count
end

local function validOffer(data: any, offer: Offer): boolean
	if data.coins < offer.coins then
		return false
	end
	for key, count in offer.items do
		local speciesId, pieceIndex = parseKey(key)
		if not owns(data, speciesId, pieceIndex, count) then
			return false
		end
	end
	return true
end

local function moveItems(fromData: any, toData: any, offer: Offer)
	fromData.coins -= offer.coins
	toData.coins += offer.coins
	for key, count in offer.items do
		local speciesId, pieceIndex = parseKey(key)
		local pk = tostring(pieceIndex)
		local fromOwned = fromData.pieces[speciesId]
		fromOwned[pk] -= count
		if fromOwned[pk] <= 0 then
			fromOwned[pk] = nil
		end
		local toOwned = toData.pieces[speciesId]
		if not toOwned then
			toOwned = {}
			toData.pieces[speciesId] = toOwned
		end
		toOwned[pk] = (toOwned[pk] or 0) + count
	end
end

local function execute(trade: Trade)
	local a, b = trade.players[1], trade.players[2]
	local dataA, dataB = DataService.Get(a), DataService.Get(b)
	if not dataA or not dataB then
		close(trade, "상대가 나갔어요")
		return
	end
	if not validOffer(dataA, trade.offers[a]) or not validOffer(dataB, trade.offers[b]) then
		close(trade, "올린 물건이 더 이상 없어서 거래가 취소됐어요")
		return
	end
	moveItems(dataA, dataB, trade.offers[a])
	moveItems(dataB, dataA, trade.offers[b])
	close(trade, "done")
	Net.Tell(a, "🤝 " .. b.DisplayName .. "님과 거래 완료!", Color3.fromRGB(140, 255, 140))
	Net.Tell(b, "🤝 " .. a.DisplayName .. "님과 거래 완료!", Color3.fromRGB(140, 255, 140))
	Net.MarkDirty(a)
	Net.MarkDirty(b)
	task.spawn(DataService.Save, a)
	task.spawn(DataService.Save, b)
end

local function changed(trade: Trade)
	trade.ready = {}
	trade.changedAt = os.clock()
	sendState(trade)
end

----------------------------------------------------------------------
Net.Handle("TradeRequest", function(player, targetUserId)
	local target = type(targetUserId) == "number" and Players:GetPlayerByUserId(targetUserId)
	if not target or target == player then
		return false, "그 플레이어를 찾을 수 없어요"
	end
	if trades[player] then
		return false, "이미 거래 중이에요"
	end
	if trades[target] then
		return false, target.DisplayName .. "님은 다른 사람과 거래 중이에요"
	end
	if not DataService.Get(target) then
		return false, "상대가 아직 불러오는 중이에요"
	end
	local now = os.clock()
	if now - (lastRequest[player] or -100) < Config.TradeRequestCooldown then
		return false, "조금 뒤에 다시 요청해 주세요"
	end
	lastRequest[player] = now
	requests[target] = { from = player, at = now }
	Net.Trade:FireClient(target, { type = "Request", fromName = player.DisplayName, fromId = player.UserId })
	return true, target.DisplayName .. "님에게 거래를 요청했어요"
end)

Net.Handle("TradeRespond", function(player, fromUserId, accept)
	local request = requests[player]
	if not request or request.from.UserId ~= fromUserId or not request.from.Parent then
		requests[player] = nil
		return false, "요청이 만료됐어요"
	end
	requests[player] = nil
	local from = request.from
	if accept ~= true then
		Net.Tell(from, player.DisplayName .. "님이 거래를 거절했어요")
		return true, nil
	end
	if os.clock() - request.at > 60 then
		return false, "요청이 만료됐어요"
	end
	if trades[from] or trades[player] then
		return false, "상대가 이미 다른 거래 중이에요"
	end
	local trade: Trade = {
		players = { from, player },
		offers = { [from] = { items = {}, coins = 0 }, [player] = { items = {}, coins = 0 } },
		ready = {},
		changedAt = os.clock(),
	}
	trades[from] = trade
	trades[player] = trade
	sendState(trade)
	return true, nil
end)

Net.Handle("TradeSetItem", function(player, speciesId, pieceIndex, count)
	local trade = trades[player]
	local data = DataService.Get(player)
	if not trade then
		return false, nil
	end
	if type(speciesId) ~= "string" or not Config.SpeciesById[speciesId] or type(pieceIndex) ~= "number" or type(count) ~= "number" then
		return false, nil
	end
	count = math.floor(count)
	pieceIndex = math.floor(pieceIndex)
	local offer = trade.offers[player]
	local key = itemKey(speciesId, pieceIndex)
	if count <= 0 then
		offer.items[key] = nil
	else
		if not owns(data, speciesId, pieceIndex, count) then
			return false, "그만큼 가지고 있지 않아요"
		end
		if offer.items[key] == nil then
			local n = 0
			for _ in offer.items do
				n += 1
			end
			if n >= Config.TradeMaxItems then
				return false, "한 번에 " .. Config.TradeMaxItems .. "종류까지 올릴 수 있어요"
			end
		end
		offer.items[key] = count
	end
	changed(trade)
	return true, nil
end)

Net.Handle("TradeSetCoins", function(player, amount)
	local trade = trades[player]
	local data = DataService.Get(player)
	if not trade or type(amount) ~= "number" then
		return false, nil
	end
	amount = math.clamp(math.floor(amount), 0, math.floor(data.coins))
	trade.offers[player].coins = amount
	changed(trade)
	return true, "💰 " .. Util.FormatNumber(amount) .. " 코인을 올렸어요"
end)

Net.Handle("TradeReady", function(player)
	local trade = trades[player]
	if not trade then
		return false, nil
	end
	if os.clock() - trade.changedAt < READY_LOCK then
		return false, "내용이 방금 바뀌었어요. 잠시 확인한 뒤 눌러 주세요"
	end
	trade.ready[player] = true
	local them = other(trade, player)
	if trade.ready[them] then
		execute(trade)
	else
		sendState(trade)
	end
	return true, nil
end)

Net.Handle("TradeCancel", function(player)
	local trade = trades[player]
	if trade then
		close(trade, player.DisplayName .. "님이 거래를 취소했어요")
	end
	return true, nil
end)

function TradeService.Init()
	Players.PlayerRemoving:Connect(function(player)
		local trade = trades[player]
		if trade then
			close(trade, "상대가 게임을 나갔어요")
		end
		requests[player] = nil
		lastRequest[player] = nil
	end)
end

return TradeService
]]></string></Properties></Item><Item class="ModuleScript" referent="RBX00000013"><Properties><string name="Name">WorldBuilder</string><string name="Source"><![CDATA[-- 맵 자동 생성: 땅, 발굴 지역 4곳, 박물관 부지 8개, 랭킹 보드
-- 맵을 직접 꾸미고 싶다면 숫자/색을 바꾸거나, 생성된 파트 주변에 장식을 추가하세요.
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)

local WorldBuilder = {}

export type ZoneWorld = {
	id: string,
	center: Vector3,
	half: number, -- 이 범위(정사각형) 안에 있으면 이 지역에 있는 것
	spots: { Vector3 },
	meteorRing: { inner: number, outer: number },
	spawn: CFrame,
	field: Folder,
}

export type World = {
	root: Folder,
	zones: { [string]: ZoneWorld },
	plots: { Model },
	boards: { [string]: BasePart },
}

local PLOT_COUNT = 8
local PLOT_RADIUS = 150
local PLOT_SIZE = 48
local ZONE_RADIUS = 330
local SPACING = 9

-- 전시대 위치 (박물관 기준 로컬 좌표, 앞쪽 = -Z)
WorldBuilder.PedestalOffsets = {}
for _, z in { -13, -3, 7, 17 } do
	for _, x in { -15, -5, 5, 15 } do
		table.insert(WorldBuilder.PedestalOffsets, Vector3.new(x, 0, z))
	end
end

local function part(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if props.Shape then
		p.Shape = props.Shape
	end
	for key, value in props do
		if key ~= "Parent" and key ~= "Shape" then
			(p :: any)[key] = value
		end
	end
	p.Parent = props.Parent
	return p
end

local function label(parent: Instance, face: Enum.NormalId, text: string, color: Color3, name: string?): TextLabel
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.Parent = parent
	local tl = Instance.new("TextLabel")
	tl.Name = name or "Text"
	tl.Size = UDim2.fromScale(1, 1)
	tl.BackgroundTransparency = 1
	tl.TextScaled = true
	tl.Font = Enum.Font.FredokaOne
	tl.TextColor3 = color
	tl.TextStrokeTransparency = 0.3
	tl.Text = text
	tl.Parent = gui
	return tl
end

----------------------------------------------------------------------
-- 박물관 부지
----------------------------------------------------------------------
local function buildPlot(parent: Instance, index: number, cf: CFrame): Model
	local plot = Instance.new("Model")
	plot.Name = "Plot" .. index
	plot:SetAttribute("Index", index)
	plot:SetAttribute("OwnerUserId", 0)

	local half = PLOT_SIZE / 2
	local marble = Color3.fromRGB(235, 230, 220)
	local wall = Color3.fromRGB(215, 205, 190)
	local trim = Color3.fromRGB(180, 150, 100)

	local floor = part({ Name = "Floor", Size = Vector3.new(PLOT_SIZE, 1, PLOT_SIZE), CFrame = cf * CFrame.new(0, 0.5, 0), Material = Enum.Material.Marble, Color = marble, Parent = plot })
	plot.PrimaryPart = floor

	part({ Name = "WallBack", Size = Vector3.new(PLOT_SIZE, 10, 1), CFrame = cf * CFrame.new(0, 6, half - 0.5), Material = Enum.Material.Marble, Color = wall, Parent = plot })
	part({ Name = "WallLeft", Size = Vector3.new(1, 6, PLOT_SIZE), CFrame = cf * CFrame.new(-half + 0.5, 4, 0), Material = Enum.Material.Marble, Color = wall, Parent = plot })
	part({ Name = "WallRight", Size = Vector3.new(1, 6, PLOT_SIZE), CFrame = cf * CFrame.new(half - 0.5, 4, 0), Material = Enum.Material.Marble, Color = wall, Parent = plot })

	for _, x in { -half + 2, -8, 8, half - 2 } do
		part({ Name = "Pillar", Shape = Enum.PartType.Cylinder, Size = Vector3.new(12, 2.4, 2.4), CFrame = cf * CFrame.new(x, 7, -half + 1.5) * CFrame.Angles(0, 0, math.rad(90)), Material = Enum.Material.Marble, Color = marble, Parent = plot })
	end
	part({ Name = "Lintel", Size = Vector3.new(PLOT_SIZE, 1.5, 3), CFrame = cf * CFrame.new(0, 13.75, -half + 1.5), Material = Enum.Material.Marble, Color = trim, Parent = plot })

	local sign = part({ Name = "Sign", Size = Vector3.new(22, 4, 0.6), CFrame = cf * CFrame.new(0, 16.5, -half + 1.5), Material = Enum.Material.Wood, Color = Color3.fromRGB(110, 75, 45), Parent = plot })
	label(sign, Enum.NormalId.Front, "빈 박물관", Color3.fromRGB(255, 240, 200), "Title")

	local likeStand = part({ Name = "LikeStand", Size = Vector3.new(3, 4, 3), CFrame = cf * CFrame.new(-11, 2, -half - 2), Material = Enum.Material.Marble, Color = Color3.fromRGB(255, 120, 150), Parent = plot })
	label(likeStand, Enum.NormalId.Front, "❤️", Color3.new(1, 1, 1), "Likes")
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "LikePrompt"
	prompt.ActionText = "좋아요 ❤️"
	prompt.ObjectText = "박물관"
	prompt.HoldDuration = 0.4
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = likeStand

	local pedestals = Instance.new("Folder")
	pedestals.Name = "Pedestals"
	pedestals.Parent = plot
	for i, offset in WorldBuilder.PedestalOffsets do
		part({ Name = tostring(i), Size = Vector3.new(6, 2, 6), CFrame = cf * CFrame.new(offset + Vector3.new(0, 2, 0)), Material = Enum.Material.Marble, Color = Color3.fromRGB(200, 195, 185), Transparency = 0.6, Parent = pedestals })
	end

	local displays = Instance.new("Folder")
	displays.Name = "Displays"
	displays.Parent = plot

	part({ Name = "Entry", Size = Vector3.new(2, 1, 2), CFrame = cf * CFrame.new(0, 3.5, -half + 6), Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false, Parent = plot })

	plot.Parent = parent
	return plot
end

----------------------------------------------------------------------
-- 발굴 지역
----------------------------------------------------------------------
local function decorate(root: Instance, zone: Config.Zone, center: Vector3, inner: number, outer: number, avoid: Vector3)
	local rng = Random.new(zone.id:len() * 7919)
	-- 입구(사막 쪽 길) 방향은 비워 둠
	local function ringPos(): Vector3
		for _ = 1, 20 do
			local a = rng:NextNumber() * math.pi * 2
			local dir = Vector3.new(math.cos(a), 0, math.sin(a))
			if dir:Dot(avoid) < 0.8 then
				local r = inner + rng:NextNumber() * (outer - inner)
				return center + dir * r
			end
		end
		return center - avoid * outer
	end
	if zone.id == "Glacier" then
		for _ = 1, 14 do
			local h = rng:NextNumber(8, 16)
			part({ Name = "IceSpike", Size = Vector3.new(3, h, 3), CFrame = CFrame.new(ringPos() + Vector3.new(0, h / 2 - 1, 0)) * CFrame.Angles(rng:NextNumber(-0.25, 0.25), rng:NextNumber(0, 6), rng:NextNumber(-0.25, 0.25)), Material = Enum.Material.Ice, Color = Color3.fromRGB(170, 220, 255), Transparency = 0.2, Parent = root })
		end
	elseif zone.id == "Volcano" then
		for _ = 1, 7 do
			local d = rng:NextNumber(8, 14)
			part({ Name = "Lava", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, d, d), CFrame = CFrame.new(ringPos() + Vector3.new(0, 0.25, 0)) * CFrame.Angles(0, 0, math.rad(90)), Material = Enum.Material.Neon, Color = Color3.fromRGB(255, 100, 20), CanCollide = false, Parent = root })
		end
		for _ = 1, 10 do
			local s = rng:NextNumber(3, 7)
			part({ Name = "Rock", Shape = Enum.PartType.Ball, Size = Vector3.new(s, s, s), CFrame = CFrame.new(ringPos()), Material = Enum.Material.Basalt, Color = Color3.fromRGB(40, 35, 35), Parent = root })
		end
		local fire = Instance.new("Fire")
		fire.Size = 20
		fire.Heat = 15
		fire.Parent = part({ Name = "Vent", Size = Vector3.new(6, 1, 6), CFrame = CFrame.new(center + (center.Unit * (outer + 6)) + Vector3.new(0, 0.5, 0)), Material = Enum.Material.Neon, Color = Color3.fromRGB(255, 120, 30), Parent = root })
	elseif zone.id == "Coast" then
		local out = center.Unit
		local sea = part({ Name = "Sea", Size = Vector3.new(220, 1, 60), CFrame = CFrame.lookAt(center + out * (outer + 30), center + out * (outer + 31)) + Vector3.new(0, -0.3, 0), Material = Enum.Material.Glass, Color = Color3.fromRGB(40, 140, 220), Transparency = 0.25, CanCollide = false, Parent = root })
		sea.CanQuery = false
		for _ = 1, 8 do
			local pos = ringPos()
			part({ Name = "PalmTrunk", Size = Vector3.new(1.2, 12, 1.2), CFrame = CFrame.new(pos + Vector3.new(0, 6, 0)) * CFrame.Angles(0.12, rng:NextNumber(0, 6), 0), Material = Enum.Material.Wood, Color = Color3.fromRGB(130, 95, 60), Parent = root })
			for k = 0, 4 do
				part({ Name = "PalmLeaf", Size = Vector3.new(7, 0.3, 1.6), CFrame = CFrame.new(pos + Vector3.new(0, 12, 0)) * CFrame.Angles(0, k * 1.26, 0) * CFrame.new(3, 0, 0) * CFrame.Angles(0, 0, -0.35), Material = Enum.Material.Grass, Color = Color3.fromRGB(60, 160, 70), CanCollide = false, Parent = root })
			end
		end
	end
end

local function buildZone(root: Folder, zone: Config.Zone, center: Vector3, grid: number): ZoneWorld
	local folder = Instance.new("Folder")
	folder.Name = zone.id
	folder.Parent = root

	local span = (grid - 1) * SPACING
	local fieldSize = span + 12
	local fieldHalf = fieldSize / 2
	local wallHalf = fieldHalf + 9
	local patch = wallHalf * 2 + 40

	-- 지역 바닥
	if zone.id ~= "Desert" then
		part({ Name = "ZoneGround", Size = Vector3.new(patch, 0.2, patch), CFrame = CFrame.new(center + Vector3.new(0, 0.05, 0)), Material = zone.groundMaterial, Color = zone.groundColor:Lerp(Color3.new(1, 1, 1), 0.15), CanQuery = false, Parent = folder })
	end
	part({ Name = "FieldFloor", Size = Vector3.new(fieldSize, 0.2, fieldSize), CFrame = CFrame.new(center + Vector3.new(0, 0.12, 0)), Material = zone.groundMaterial, Color = zone.groundColor, Parent = folder })

	local toDesert = if center.Magnitude > 1 then -center.Unit else Vector3.new(0, 0, -1)

	if zone.price <= 0 then
		-- 울타리
		local fenceColor = Color3.fromRGB(120, 85, 50)
		for _, side in { { 0, -1 }, { 0, 1 }, { -1, 0 }, { 1, 0 } } do
			local sx, sz = side[1], side[2]
			local alongX = sz ~= 0
			local size = if alongX then Vector3.new(fieldSize, 1, 0.6) else Vector3.new(0.6, 1, fieldSize)
			part({ Name = "Fence", Size = size, CFrame = CFrame.new(center + Vector3.new(sx * fieldHalf, 2, sz * fieldHalf)), Material = Enum.Material.WoodPlanks, Color = fenceColor, CanCollide = false, Parent = folder })
			for t = -fieldHalf, fieldHalf, 10 do
				local offset = if alongX then Vector3.new(t, 1.5, sz * fieldHalf) else Vector3.new(sx * fieldHalf, 1.5, t)
				part({ Name = "Post", Size = Vector3.new(0.8, 3, 0.8), CFrame = CFrame.new(center + offset), Material = Enum.Material.Wood, Color = fenceColor, CanCollide = false, Parent = folder })
			end
		end
	else
		-- 잠금 벽 (잠긴 플레이어의 화면에서만 단단해짐 → 클라이언트가 처리)
		local barrier = Instance.new("Folder")
		barrier.Name = "Barrier"
		barrier:SetAttribute("Zone", zone.id)
		barrier.Parent = folder
		local text = string.format("🔒 %s %s\n💰 %s 코인으로 열기", zone.emoji, zone.name, Util.FormatNumber(zone.price))
		for _, side in { { 0, -1 }, { 0, 1 }, { -1, 0 }, { 1, 0 } } do
			local sx, sz = side[1], side[2]
			local alongX = sz ~= 0
			local size = if alongX then Vector3.new(wallHalf * 2, 14, 1) else Vector3.new(1, 14, wallHalf * 2)
			local wall = part({ Name = "Wall", Size = size, CFrame = CFrame.new(center + Vector3.new(sx * wallHalf, 7, sz * wallHalf)), Material = Enum.Material.ForceField, Color = zone.barrierColor, Transparency = 0.3, CanCollide = false, CanQuery = false, Parent = barrier })
			for _, face in { Enum.NormalId.Front, Enum.NormalId.Back, Enum.NormalId.Left, Enum.NormalId.Right } do
				local isLong = (alongX and (face == Enum.NormalId.Front or face == Enum.NormalId.Back)) or (not alongX and (face == Enum.NormalId.Left or face == Enum.NormalId.Right))
				if isLong then
					local gui = Instance.new("SurfaceGui")
					gui.Face = face
					gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
					gui.PixelsPerStud = 12
					gui.Parent = wall
					local tl = Instance.new("TextLabel")
					tl.Size = UDim2.fromScale(1, 0.5)
					tl.Position = UDim2.fromScale(0, 0.25)
					tl.BackgroundTransparency = 1
					tl.TextScaled = true
					tl.Font = Enum.Font.FredokaOne
					tl.TextColor3 = Color3.new(1, 1, 1)
					tl.TextStrokeTransparency = 0.2
					tl.Text = text
					tl.Parent = gui
				end
			end
		end
	end

	-- 지역 간판
	local signPos = center + toDesert * (wallHalf + 5)
	local sign = part({ Name = "ZoneSign", Size = Vector3.new(18, 4, 0.6), CFrame = CFrame.lookAt(signPos + Vector3.new(0, 7, 0), signPos + Vector3.new(0, 7, 0) + toDesert), Material = Enum.Material.Wood, Color = Color3.fromRGB(110, 75, 45), Parent = folder })
	label(sign, Enum.NormalId.Front, zone.emoji .. " " .. zone.name, Color3.fromRGB(255, 230, 160))
	label(sign, Enum.NormalId.Back, zone.emoji .. " " .. zone.name, Color3.fromRGB(255, 230, 160))

	local field = Instance.new("Folder")
	field.Name = "Mounds"
	field.Parent = folder

	local spots = {}
	local start = -span / 2
	for gx = 0, grid - 1 do
		for gz = 0, grid - 1 do
			table.insert(spots, center + Vector3.new(start + gx * SPACING, 0, start + gz * SPACING))
		end
	end

	if zone.id ~= "Desert" then
		decorate(folder, zone, center, wallHalf + 4, patch / 2 - 2, toDesert)
	end

	-- 들어가는 위치: 벽 안쪽, 사막 방향
	local spawnPos = center + toDesert * (fieldHalf + 3) + Vector3.new(0, 3, 0)
	return {
		id = zone.id,
		center = center,
		half = wallHalf,
		spots = spots,
		meteorRing = { inner = fieldHalf + 1.5, outer = wallHalf - 2.5 },
		spawn = CFrame.lookAt(spawnPos, Vector3.new(center.X, spawnPos.Y, center.Z)),
		field = field,
	}
end

----------------------------------------------------------------------
-- 랭킹 보드
----------------------------------------------------------------------
local function buildBoard(root: Instance, name: string, title: string, color: Color3, cf: CFrame): BasePart
	local board = part({ Name = name, Size = Vector3.new(14, 16, 1), CFrame = cf, Material = Enum.Material.Wood, Color = Color3.fromRGB(60, 45, 30), Parent = root })
	part({ Name = "Leg", Size = Vector3.new(1, 4, 1), CFrame = cf * CFrame.new(-5, -9, 0), Material = Enum.Material.Wood, Color = Color3.fromRGB(60, 45, 30), Parent = root })
	part({ Name = "Leg", Size = Vector3.new(1, 4, 1), CFrame = cf * CFrame.new(5, -9, 0), Material = Enum.Material.Wood, Color = Color3.fromRGB(60, 45, 30), Parent = root })
	local gui = Instance.new("SurfaceGui")
	gui.Name = "BoardGui"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.Parent = board
	local titleLabel = Instance.new("TextLabel")
	titleLabel.Name = "Title"
	titleLabel.Size = UDim2.fromScale(1, 0.12)
	titleLabel.BackgroundTransparency = 1
	titleLabel.Font = Enum.Font.FredokaOne
	titleLabel.TextScaled = true
	titleLabel.TextColor3 = color
	titleLabel.Text = title
	titleLabel.Parent = gui
	local list = Instance.new("TextLabel")
	list.Name = "List"
	list.Position = UDim2.fromScale(0.05, 0.14)
	list.Size = UDim2.fromScale(0.9, 0.84)
	list.BackgroundTransparency = 1
	list.Font = Enum.Font.GothamBold
	list.TextScaled = true
	list.TextColor3 = Color3.new(1, 1, 1)
	list.TextXAlignment = Enum.TextXAlignment.Left
	list.TextYAlignment = Enum.TextYAlignment.Top
	list.Text = "불러오는 중..."
	list.Parent = gui
	return board
end

----------------------------------------------------------------------
function WorldBuilder.Build(): World
	local existing = workspace:FindFirstChild("FossilWorld")
	if existing then
		existing:Destroy()
	end
	local root = Instance.new("Folder")
	root.Name = "FossilWorld"
	root.Parent = workspace

	local baseplate = workspace:FindFirstChild("Baseplate")
	if baseplate and baseplate:IsA("BasePart") then
		baseplate.Transparency = 1
		baseplate.CanCollide = false
		baseplate.CanQuery = false
	end

	part({ Name = "Ground", Size = Vector3.new(1100, 4, 1100), CFrame = CFrame.new(0, -2, 0), Material = Enum.Material.Sand, Color = Color3.fromRGB(226, 198, 140), Parent = root })

	-- 발굴 지역
	local zones = {}
	for _, zone in Config.Zones do
		local center = Vector3.zero
		local grid = 10
		if zone.angle then
			local a = math.rad(zone.angle)
			center = Vector3.new(math.cos(a) * ZONE_RADIUS, 0, math.sin(a) * ZONE_RADIUS)
			grid = 8
		end
		zones[zone.id] = buildZone(root, zone, center, grid)
		-- 사막에서 이 지역까지 길
		if zone.angle then
			local dir = center.Unit
			local a0 = dir * (zones.Desert.half + 4)
			local a1 = center - dir * (zones[zone.id].half + 1)
			local len = (a1 - a0).Magnitude
			part({ Name = "ZonePath", Size = Vector3.new(9, 0.2, len), CFrame = CFrame.lookAt((a0 + a1) / 2 + Vector3.new(0, 0.1, 0), a1 + Vector3.new(0, 0.1, 0)), Material = Enum.Material.Cobblestone, Color = Color3.fromRGB(150, 140, 125), CanQuery = false, Parent = root })
		end
	end

	-- 사막 시작 지점 (발굴장 쪽을 바라봄)
	local desert = zones.Desert
	local spawnPos = Vector3.new(0, 0.5, -desert.half - 14)
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(10, 1, 10)
	spawn.CFrame = CFrame.lookAt(spawnPos, Vector3.new(0, 0.5, 0))
	spawn.Material = Enum.Material.Slate
	spawn.Color = Color3.fromRGB(180, 160, 120)
	spawn.Duration = 0
	spawn.Parent = root
	desert.spawn = spawn.CFrame + Vector3.new(0, 3, 0)

	-- 랭킹 보드 (시작 지점 양옆)
	local boards = {}
	for _, info in { { "FossilBoard", "🏆 완성 화석 랭킹", Color3.fromRGB(255, 210, 80), -22 }, { "LikeBoard", "❤️ 이번 주 좋아요 랭킹", Color3.fromRGB(255, 130, 160), 22 } } do
		-- 시작 지점 앞 양옆, 시작 지점 쪽을 바라봄
		local pos = Vector3.new(info[4], 11, spawnPos.Z + 6)
		boards[info[1]] = buildBoard(root, info[1], info[2], info[3], CFrame.lookAt(pos, pos - Vector3.new(0, 0, 10)))
	end

	-- 박물관 부지 + 길
	local plots = {}
	for i = 1, PLOT_COUNT do
		local angle = (i - 1) / PLOT_COUNT * math.pi * 2
		local pos = Vector3.new(math.cos(angle) * PLOT_RADIUS, 0, math.sin(angle) * PLOT_RADIUS)
		local cf = CFrame.lookAt(pos, Vector3.zero) -- 입구(-Z)가 발굴장을 향함
		table.insert(plots, buildPlot(root, i, cf))

		local pathStart = pos.Unit * (desert.half + 2)
		local pathEnd = pos.Unit * (PLOT_RADIUS - PLOT_SIZE / 2 - 1)
		local mid = (pathStart + pathEnd) / 2
		local len = (pathEnd - pathStart).Magnitude
		part({ Name = "Path", Size = Vector3.new(7, 0.2, len), CFrame = CFrame.lookAt(mid + Vector3.new(0, 0.1, 0), pathEnd + Vector3.new(0, 0.1, 0)), Material = Enum.Material.Cobblestone, Color = Color3.fromRGB(170, 160, 145), CanQuery = false, Parent = root })
	end

	Lighting.ClockTime = 14.5
	Lighting.Brightness = 2.5
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 140, 125)

	return {
		root = root,
		zones = zones,
		plots = plots,
		boards = boards,
	}
end

return WorldBuilder
]]></string></Properties></Item><Item class="ModuleScript" referent="RBX00000014"><Properties><string name="Name">Zones</string><string name="Source"><![CDATA[-- 발굴 지역: 위치로 지역 찾기, 잠금 확인
local Zones = {}

local world: any = nil

function Zones.Init(builtWorld: any)
	world = builtWorld
end

function Zones.Get(zoneId: string): any
	return world and world.zones[zoneId]
end

-- 이 위치가 어느 지역 안인지 (없으면 nil)
function Zones.At(position: Vector3): string?
	if not world then
		return nil
	end
	for id, zone in world.zones do
		local d = position - zone.center
		if math.abs(d.X) <= zone.half and math.abs(d.Z) <= zone.half then
			return id
		end
	end
	return nil
end

function Zones.PlayerZone(player: Player): string?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return nil
	end
	return Zones.At(root.Position)
end

function Zones.IsUnlocked(data: any, zoneId: string): boolean
	return data.unlockedZones[zoneId] == true
end

return Zones
]]></string></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX0000002A"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX00000029"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX00000028"><Properties><string name="Name">Client</string></Properties><Item class="ModuleScript" referent="RBX00000017"><Properties><string name="Name">Barriers</string><string name="Source"><![CDATA[-- 잠긴 지역의 벽: 내 화면에서만 단단하게 (열린 지역은 투명해지고 통과 가능)
-- 캐릭터 물리는 내 컴퓨터가 계산하므로, 여기서 CanCollide 를 바꾸면 나에게만 적용돼요.
local Barriers = {}

local unlocked: { [string]: boolean } = { Desert = true }

local function applyWall(wall: BasePart)
	local barrier = wall.Parent
	if not barrier or barrier.Name ~= "Barrier" then
		return
	end
	local open = unlocked[barrier:GetAttribute("Zone") or ""] == true
	wall.CanCollide = not open
	wall.Transparency = if open then 1 else 0.3
	for _, gui in wall:GetChildren() do
		if gui:IsA("SurfaceGui") then
			gui.Enabled = not open
		end
	end
end

function Barriers.Update(unlockedZones: { [string]: boolean })
	unlocked = unlockedZones
	local root = workspace:FindFirstChild("FossilWorld")
	if not root then
		return
	end
	for _, zoneFolder in root:GetChildren() do
		local barrier = zoneFolder:FindFirstChild("Barrier")
		if barrier then
			for _, wall in barrier:GetChildren() do
				if wall:IsA("BasePart") then
					applyWall(wall)
				end
			end
		end
	end
end

-- 스트리밍으로 벽이 나중에 불러와져도 적용
workspace.DescendantAdded:Connect(function(inst)
	if inst:IsA("BasePart") and inst.Name == "Wall" then
		applyWall(inst)
	elseif inst:IsA("SurfaceGui") and inst.Parent and inst.Parent:IsA("BasePart") and inst.Parent.Name == "Wall" then
		applyWall(inst.Parent :: BasePart)
	end
end)

return Barriers
]]></string></Properties></Item><Item class="ModuleScript" referent="RBX00000018"><Properties><string name="Name">Digger</string><string name="Source"><![CDATA[-- 삽을 들고 클릭/터치(누르고 있기)하면 흙더미를 팜
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)

local Digger = {}

local player = Players.LocalPlayer
local mouse = player:GetMouse()
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local digRemote = remotes:WaitForChild("Dig") :: RemoteEvent

local getCooldown: () -> number = function()
	return 0.5
end
local onTooFar: () -> () = function() end
-- 자동 발굴: (켜짐 여부, 열린 지역 목록)
local getAuto: () -> (boolean, { [string]: boolean }) = function()
	return false, {}
end

local equippedTool: Tool? = nil
local holding = false
local digging = false

local highlight = Instance.new("Highlight")
highlight.FillTransparency = 0.75
highlight.FillColor = Color3.fromRGB(255, 230, 120)
highlight.OutlineColor = Color3.fromRGB(255, 240, 180)
highlight.DepthMode = Enum.HighlightDepthMode.Occluded
highlight.Parent = workspace

local function targetMound(): BasePart?
	local target = mouse.Target
	if target and CollectionService:HasTag(target, "DigMound") and target.Transparency < 1 then
		return target
	end
	return nil
end

local function inRange(part: BasePart): boolean
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	return root ~= nil and (root.Position - part.Position).Magnitude <= Config.DigRange - 0.5
end

local function digLoop()
	if digging then
		return
	end
	digging = true
	local lastWarn = 0
	while holding and equippedTool and equippedTool.Parent == player.Character do
		local mound = targetMound()
		if mound then
			if inRange(mound) then
				digRemote:FireServer(mound)
				-- 손맛: 도구를 살짝 흔들기
				local tool = equippedTool
				local grip = tool.Grip
				tool.Grip = grip * CFrame.Angles(math.rad(-35), 0, 0)
				task.delay(0.12, function()
					if tool.Parent then
						tool.Grip = grip
					end
				end)
			elseif os.clock() - lastWarn > 2 then
				lastWarn = os.clock()
				onTooFar()
			end
		end
		task.wait(getCooldown())
	end
	digging = false
end

local function hookTool(tool: Tool)
	if tool:GetAttribute("Hooked") then
		return
	end
	tool:SetAttribute("Hooked", true)
	tool.Equipped:Connect(function()
		equippedTool = tool
	end)
	tool.Unequipped:Connect(function()
		if equippedTool == tool then
			equippedTool = nil
		end
		holding = false
	end)
	tool.Activated:Connect(function()
		holding = true
		task.spawn(digLoop)
	end)
	tool.Deactivated:Connect(function()
		holding = false
	end)
end

local function watch(container: Instance)
	container.ChildAdded:Connect(function(child)
		if child:IsA("Tool") and child:GetAttribute("DigTool") then
			hookTool(child)
			if child.Parent == player.Character then
				equippedTool = child
			end
		end
	end)
	for _, child in container:GetChildren() do
		if child:IsA("Tool") and child:GetAttribute("DigTool") then
			hookTool(child)
		end
	end
end

local function nearestMound(unlocked: { [string]: boolean }): BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return nil
	end
	local best, bestDist = nil, Config.DigRange - 1
	for _, mound in CollectionService:GetTagged("DigMound") do
		if mound:IsA("BasePart") and mound.Transparency < 1 and unlocked[mound:GetAttribute("Zone") or ""] then
			local d = (mound.Position - root.Position).Magnitude
			if d < bestDist then
				best, bestDist = mound, d
			end
		end
	end
	return best
end

local function autoLoop()
	while true do
		local enabled, unlocked = getAuto()
		local tool = equippedTool
		if enabled and tool and tool.Parent == player.Character and not holding then
			local mound = nearestMound(unlocked)
			if mound then
				digRemote:FireServer(mound)
			end
			task.wait(getCooldown())
		else
			task.wait(0.3)
		end
	end
end

function Digger.Init(cooldownFn: () -> number, tooFarFn: () -> (), autoFn: () -> (boolean, { [string]: boolean }))
	getCooldown = cooldownFn
	onTooFar = tooFarFn
	getAuto = autoFn
	task.spawn(autoLoop)

	local function onCharacter(character: Model)
		equippedTool = nil
		holding = false
		watch(character)
		local backpack = player:WaitForChild("Backpack")
		watch(backpack)
	end
	player.CharacterAdded:Connect(onCharacter)
	player.ChildAdded:Connect(function(child)
		if child:IsA("Backpack") then
			watch(child)
		end
	end)
	if player.Character then
		onCharacter(player.Character)
	end

	-- 마우스를 올린 흙더미 강조
	RunService.RenderStepped:Connect(function()
		if equippedTool and equippedTool.Parent == player.Character then
			local mound = targetMound()
			highlight.Adornee = mound
			if mound then
				highlight.OutlineColor = if inRange(mound) then Color3.fromRGB(255, 240, 180) else Color3.fromRGB(255, 90, 90)
			end
		else
			highlight.Adornee = nil
		end
	end)
end

return Digger
]]></string></Properties></Item><Item class="ModuleScript" referent="RBX00000019"><Properties><string name="Name">Effects</string><string name="Source"><![CDATA[-- 흙 튀기기, 코인 숫자 떠오르기 같은 연출 (내 화면에서만)
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")

local Effects = {}

local folder = Instance.new("Folder")
folder.Name = "LocalEffects"
folder.Parent = workspace

function Effects.DirtBurst(position: Vector3, color: Color3, big: boolean)
	local count = if big then 12 else 4
	for _ = 1, count do
		local chunk = Instance.new("Part")
		chunk.Size = Vector3.one * (0.3 + math.random() * 0.4)
		chunk.Color = color
		chunk.Material = Enum.Material.Ground
		chunk.CanCollide = false
		chunk.CanQuery = false
		chunk.CanTouch = false
		chunk.CastShadow = false
		chunk.Position = position + Vector3.new(math.random() * 2 - 1, 1.5, math.random() * 2 - 1)
		chunk.Parent = folder
		chunk.AssemblyLinearVelocity = Vector3.new(math.random() * 16 - 8, 12 + math.random() * 10, math.random() * 16 - 8)
		Debris:AddItem(chunk, 0.9)
	end
end

function Effects.FloatText(position: Vector3, text: string, color: Color3)
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.one * 0.2
	anchor.Position = position + Vector3.new(0, 3, 0)
	anchor.Parent = folder

	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(160, 40)
	gui.AlwaysOnTop = true
	gui.Parent = anchor
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = color
	label.TextStrokeTransparency = 0.2
	label.Text = text
	label.Parent = gui

	local info = TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(anchor, info, { Position = anchor.Position + Vector3.new(0, 4, 0) }):Play()
	TweenService:Create(label, info, { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	Debris:AddItem(anchor, 1.1)
end

return Effects
]]></string></Properties></Item><Item class="ModuleScript" referent="RBX0000001A"><Properties><string name="Name">Gui</string><string name="Source"><![CDATA[-- UI 만들기 도우미
local Gui = {}

Gui.Colors = {
	Panel = Color3.fromRGB(30, 26, 22),
	PanelLight = Color3.fromRGB(52, 45, 38),
	Text = Color3.fromRGB(255, 245, 225),
	SubText = Color3.fromRGB(200, 185, 160),
	Gold = Color3.fromRGB(255, 205, 70),
	Green = Color3.fromRGB(70, 190, 90),
	Blue = Color3.fromRGB(70, 140, 230),
	Red = Color3.fromRGB(220, 70, 70),
	Disabled = Color3.fromRGB(90, 85, 80),
}

-- Gui.new("Frame", { Size = ..., Parent = ... }, { 자식들 })
function Gui.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className)
	local parent = nil
	if props then
		for key, value in props do
			if key == "Parent" then
				parent = value
			else
				(inst :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function Gui.corner(radius: number?): UICorner
	return Gui.new("UICorner", { CornerRadius = UDim.new(0, radius or 10) })
end

function Gui.stroke(color: Color3?, thickness: number?): UIStroke
	return Gui.new("UIStroke", {
		Color = color or Color3.new(0, 0, 0),
		Thickness = thickness or 2,
		Transparency = 0.3,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Gui.padding(px: number): UIPadding
	return Gui.new("UIPadding", {
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
	})
end

function Gui.label(props: { [string]: any }): TextLabel
	local defaults = {
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextColor3 = Gui.Colors.Text,
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Left,
	}
	for k, v in props do
		defaults[k] = v
	end
	local children = { Gui.new("UITextSizeConstraint", { MaxTextSize = props.MaxTextSize or 22 }) }
	defaults.MaxTextSize = nil
	return Gui.new("TextLabel", defaults, children)
end

function Gui.button(props: { [string]: any }, onClick: () -> ()): TextButton
	local defaults = {
		BackgroundColor3 = Gui.Colors.Blue,
		Font = Enum.Font.FredokaOne,
		TextColor3 = Color3.new(1, 1, 1),
		TextScaled = true,
		AutoButtonColor = true,
	}
	for k, v in props do
		defaults[k] = v
	end
	local maxText = props.MaxTextSize or 20
	defaults.MaxTextSize = nil
	local button = Gui.new("TextButton", defaults, {
		Gui.corner(8),
		Gui.stroke(Color3.new(0, 0, 0), 1.5),
		Gui.new("UITextSizeConstraint", { MaxTextSize = maxText }),
		Gui.new("UIPadding", { PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6), PaddingTop = UDim.new(0, 3), PaddingBottom = UDim.new(0, 3) }),
	})
	button.Activated:Connect(onClick)
	return button
end

return Gui
]]></string></Properties></Item><Item class="ModuleScript" referent="RBX0000001B"><Properties><string name="Name">HelperVisuals</string><string name="Source"><![CDATA[-- 발굴 조수 모형: 모든 플레이어의 조수를 내 화면에 그림 (서버 부담 없음)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)

local HelperVisuals = {}

local folder = Instance.new("Folder")
folder.Name = "HelperVisuals"
folder.Parent = workspace

type Buddy = { model: Model, body: BasePart, offset: Vector3, phase: number, hop: number }
local buddies: { [Player]: { Buddy } } = {}

local function newPart(parent: Instance, shape: Enum.PartType, size: Vector3, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Shape = shape
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Parent = parent
	return p
end

local function buildBuddy(helper: Config.Helper): (Model, BasePart)
	local model = Instance.new("Model")
	model.Name = helper.id
	local glow = helper.price >= 25000000
	local body = newPart(model, Enum.PartType.Ball, Vector3.new(1.6, 1.6, 1.6), helper.color, if glow then Enum.Material.Neon else nil)
	body.Name = "Body"
	model.PrimaryPart = body
	local head = newPart(model, Enum.PartType.Ball, Vector3.new(1.1, 1.1, 1.1), helper.color:Lerp(Color3.new(1, 1, 1), 0.2), if glow then Enum.Material.Neon else nil)
	head.Name = "Head"
	for _, side in { -1, 1 } do
		local eye = newPart(model, Enum.PartType.Ball, Vector3.new(0.25, 0.25, 0.25), Color3.new(0.05, 0.05, 0.05))
		eye.Name = "Eye" .. side
	end
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(120, 20)
	gui.StudsOffset = Vector3.new(0, 2.2, 0)
	gui.MaxDistance = 50
	gui.Parent = body
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.TextColor3 = helper.color
	label.TextStrokeTransparency = 0.3
	label.Text = helper.name
	label.Parent = gui
	model.Parent = folder
	return model, body
end

local function rebuild(player: Player)
	local old = buddies[player]
	if old then
		for _, buddy in old do
			buddy.model:Destroy()
		end
	end
	local list = {}
	local raw = player:GetAttribute("Helpers")
	if type(raw) == "string" and raw ~= "" then
		local ids = string.split(raw, ",")
		for i, id in ids do
			local helper = Config.HelperById[id]
			if helper then
				local model, body = buildBuddy(helper)
				-- 플레이어 뒤쪽 반원에 줄 세우기
				local angle = math.rad(180 + (i - (#ids + 1) / 2) * 35)
				table.insert(list, {
					model = model,
					body = body,
					offset = Vector3.new(math.sin(angle) * 5, 0, -math.cos(angle) * 5),
					phase = i * 1.3,
					hop = 0,
				})
			end
		end
	end
	buddies[player] = list
end

-- 조수가 흙더미를 팠을 때 깡충
function HelperVisuals.Hop(player: Player)
	local list = buddies[player]
	if list and #list > 0 then
		list[math.random(1, #list)].hop = 1
	end
end

local function watch(player: Player)
	player:GetAttributeChangedSignal("Helpers"):Connect(function()
		rebuild(player)
	end)
	rebuild(player)
end

function HelperVisuals.Init()
	Players.PlayerAdded:Connect(watch)
	for _, player in Players:GetPlayers() do
		watch(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		local list = buddies[player]
		if list then
			for _, buddy in list do
				buddy.model:Destroy()
			end
		end
		buddies[player] = nil
	end)

	RunService.RenderStepped:Connect(function(dt)
		local t = os.clock()
		for player, list in buddies do
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				local base = root.CFrame
				for _, buddy in list do
					buddy.hop = math.max(0, buddy.hop - dt * 3)
					local bob = math.sin(t * 4 + buddy.phase) * 0.25 + math.sin(buddy.hop * math.pi) * 2
					local targetPos = (base * CFrame.new(buddy.offset)).Position - Vector3.new(0, 1.8, 0) + Vector3.new(0, bob, 0)
					local current = buddy.body.Position
					local pos = current:Lerp(targetPos, math.clamp(dt * 6, 0, 1))
					if (pos - targetPos).Magnitude > 40 then
						pos = targetPos -- 순간이동했을 때 따라붙기
					end
					local look = base.LookVector * Vector3.new(1, 0, 1)
					local cf = CFrame.lookAt(pos, pos + (if look.Magnitude > 0.01 then look else Vector3.zAxis))
					buddy.body.CFrame = cf
					local head = buddy.model:FindFirstChild("Head") :: BasePart
					head.CFrame = cf * CFrame.new(0, 0.9, -0.6)
					for _, side in { -1, 1 } do
						local eye = buddy.model:FindFirstChild("Eye" .. side) :: BasePart
						eye.CFrame = head.CFrame * CFrame.new(side * 0.25, 0.15, -0.48)
					end
				end
			end
		end
	end)
end

return HelperVisuals
]]></string></Properties></Item><Item class="ModuleScript" referent="RBX0000001C"><Properties><string name="Name">Hud</string><string name="Source"><![CDATA[-- 화면 위 정보: 코인, 수입, 이벤트 배너, 메뉴 버튼, 알림
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Util = require(ReplicatedStorage.Shared.Util)
local Gui = require(script.Parent.Gui)

local Hud = {}

local player = Players.LocalPlayer
local screen: ScreenGui
local coinsLabel: TextLabel
local incomeLabel: TextLabel
local boostLabel: TextLabel
local eventLabel: TextLabel
local serverLuckLabel: TextLabel
local toastHolder: Frame
local badges: { [string]: Frame } = {}

function Hud.Create(onMenu: (string) -> ())
	screen = Gui.new("ScreenGui", {
		Name = "FossilHud",
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})

	-- 코인 표시 (위 가운데)
	local top = Gui.new("Frame", {
		Name = "Top",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.fromOffset(260, 62),
		BackgroundColor3 = Gui.Colors.Panel,
		BackgroundTransparency = 0.15,
		Parent = screen,
	}, { Gui.corner(14), Gui.stroke(Gui.Colors.Gold, 2) })
	coinsLabel = Gui.label({
		Size = UDim2.new(1, -16, 0, 34),
		Position = UDim2.fromOffset(8, 4),
		Font = Enum.Font.FredokaOne,
		TextColor3 = Gui.Colors.Gold,
		TextXAlignment = Enum.TextXAlignment.Center,
		Text = "💰 0",
		MaxTextSize = 30,
		Parent = top,
	})
	incomeLabel = Gui.label({
		Size = UDim2.new(1, -16, 0, 20),
		Position = UDim2.fromOffset(8, 38),
		TextColor3 = Gui.Colors.SubText,
		TextXAlignment = Enum.TextXAlignment.Center,
		Text = "🏛️ +0/초",
		MaxTextSize = 16,
		Parent = top,
	})

	boostLabel = Gui.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 74),
		Size = UDim2.fromOffset(260, 20),
		TextColor3 = Color3.fromRGB(130, 255, 130),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextStrokeTransparency = 0.4,
		Text = "",
		MaxTextSize = 16,
		Visible = false,
		Parent = screen,
	})

	serverLuckLabel = Gui.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 94),
		Size = UDim2.fromOffset(260, 20),
		TextColor3 = Color3.fromRGB(255, 235, 120),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextStrokeTransparency = 0.4,
		Text = "",
		MaxTextSize = 16,
		Visible = false,
		Parent = screen,
	})

	-- 운석 이벤트 배너
	local banner = Gui.new("Frame", {
		Name = "Event",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 8),
		Size = UDim2.fromOffset(210, 40),
		BackgroundColor3 = Color3.fromRGB(45, 25, 70),
		BackgroundTransparency = 0.15,
		Parent = screen,
	}, { Gui.corner(10), Gui.stroke(Color3.fromRGB(180, 120, 255), 2) })
	eventLabel = Gui.label({
		Size = UDim2.new(1, -12, 1, -8),
		Position = UDim2.fromOffset(6, 4),
		TextXAlignment = Enum.TextXAlignment.Center,
		Text = "☄️ 운석까지 --:--",
		MaxTextSize = 17,
		Parent = banner,
	})

	-- 왼쪽 메뉴 버튼
	local menu = Gui.new("Frame", {
		Name = "Menu",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 10, 0.5, 0),
		Size = UDim2.fromOffset(2 * 108 + 6, 4 * 46 + 3 * 6),
		BackgroundTransparency = 1,
		Parent = screen,
	}, {
		Gui.new("UIGridLayout", { CellSize = UDim2.fromOffset(108, 46), CellPadding = UDim2.fromOffset(6, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local buttons = {
		{ id = "Collection", text = "📖 도감", color = Color3.fromRGB(200, 140, 60) },
		{ id = "Shop", text = "🛒 상점", color = Gui.Colors.Green },
		{ id = "Zones", text = "🗺️ 지역", color = Color3.fromRGB(60, 140, 210) },
		{ id = "Helpers", text = "🦖 조수", color = Color3.fromRGB(90, 170, 80) },
		{ id = "Quests", text = "📜 퀘스트", color = Color3.fromRGB(210, 160, 50) },
		{ id = "Rebirth", text = "🔁 환생", color = Color3.fromRGB(190, 80, 200) },
		{ id = "Trade", text = "🤝 거래", color = Color3.fromRGB(70, 160, 200) },
		{ id = "Museum", text = "🏛️ 박물관", color = Color3.fromRGB(150, 110, 80) },
	}
	for i, info in buttons do
		local b = Gui.button({
			Name = info.id,
			LayoutOrder = i,
			BackgroundColor3 = info.color,
			Text = info.text,
			MaxTextSize = 17,
			Parent = menu,
		}, function()
			onMenu(info.id)
		end)
		local badge = Gui.new("Frame", {
			Name = "Badge",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(1, -4, 0, 4),
			Size = UDim2.fromOffset(18, 18),
			BackgroundColor3 = Gui.Colors.Red,
			Visible = false,
			ZIndex = 3,
			Parent = b,
		}, { Gui.corner(9) })
		Gui.label({ Size = UDim2.fromScale(1, 1), Text = "!", TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 4, MaxTextSize = 14, Parent = badge })
		badges[info.id] = badge
	end

	-- 알림 목록 (아래 가운데)
	toastHolder = Gui.new("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -90),
		Size = UDim2.fromOffset(440, 260),
		BackgroundTransparency = 1,
		Parent = screen,
	}, {
		Gui.new("UIListLayout", {
			Padding = UDim.new(0, 6),
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
		Gui.new("UISizeConstraint", { MaxSize = Vector2.new(440, 260) }),
	})

	return screen
end

function Hud.GetScreen(): ScreenGui
	return screen
end

function Hud.SetCoins(coins: number)
	coinsLabel.Text = "💰 " .. Util.FormatNumber(coins)
end

function Hud.SetIncome(income: number)
	incomeLabel.Text = "🏛️ 관람 수입 +" .. Util.FormatNumber(income) .. "/초"
end

function Hud.SetBoost(secondsLeft: number)
	if secondsLeft > 0 then
		boostLabel.Visible = true
		boostLabel.Text = "🍀 행운 부스트 " .. Util.FormatTime(secondsLeft)
	else
		boostLabel.Visible = false
	end
end

function Hud.SetEvent(text: string)
	eventLabel.Text = text
end

function Hud.SetServerLuck(secondsLeft: number)
	if secondsLeft > 0 then
		serverLuckLabel.Visible = true
		serverLuckLabel.Text = "🌟 서버 행운 2배 " .. Util.FormatTime(secondsLeft)
	else
		serverLuckLabel.Visible = false
	end
end

-- 예/아니오 창 (거래 요청 등)
function Hud.Prompt(text: string, yesText: string, noText: string, onAnswer: (boolean) -> (), timeout: number?)
	local frame = Gui.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 110),
		Size = UDim2.fromOffset(360, 110),
		BackgroundColor3 = Gui.Colors.Panel,
		ZIndex = 30,
		Parent = screen,
	}, { Gui.corner(14), Gui.stroke(Gui.Colors.Blue, 3) })
	Gui.label({ Position = UDim2.fromOffset(12, 8), Size = UDim2.new(1, -24, 0, 44), Text = text, TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = true, MaxTextSize = 18, ZIndex = 31, Parent = frame })
	local answered = false
	local function answer(value: boolean)
		if answered then
			return
		end
		answered = true
		frame:Destroy()
		onAnswer(value)
	end
	Gui.button({ Position = UDim2.new(0, 12, 1, -50), Size = UDim2.new(0.5, -18, 0, 40), BackgroundColor3 = Gui.Colors.Green, Text = yesText, ZIndex = 31, Parent = frame }, function()
		answer(true)
	end)
	Gui.button({ Position = UDim2.new(0.5, 6, 1, -50), Size = UDim2.new(0.5, -18, 0, 40), BackgroundColor3 = Gui.Colors.Red, Text = noText, ZIndex = 31, Parent = frame }, function()
		answer(false)
	end)
	task.delay(timeout or 30, function()
		answer(false)
	end)
end

function Hud.SetBadge(id: string, visible: boolean)
	local badge = badges[id]
	if badge then
		badge.Visible = visible
	end
end

local toastOrder = 0
-- big = true 면 크게 표시 (희귀 발견 등)
function Hud.Toast(text: string, color: Color3?, big: boolean?, duration: number?)
	toastOrder += 1
	local height = if big then 52 else 34
	local frame = Gui.new("Frame", {
		LayoutOrder = toastOrder,
		Size = UDim2.new(1, 0, 0, height),
		BackgroundColor3 = Gui.Colors.Panel,
		BackgroundTransparency = 0.15,
		Parent = toastHolder,
	}, { Gui.corner(10), Gui.stroke(color or Gui.Colors.SubText, if big then 3 else 1.5) })
	local label = Gui.label({
		Size = UDim2.new(1, -16, 1, -8),
		Position = UDim2.fromOffset(8, 4),
		Text = text,
		TextColor3 = color or Gui.Colors.Text,
		TextXAlignment = Enum.TextXAlignment.Center,
		Font = if big then Enum.Font.FredokaOne else Enum.Font.GothamBold,
		MaxTextSize = if big then 24 else 17,
		Parent = frame,
	})
	if big then
		local scale = Gui.new("UIScale", { Scale = 0.6, Parent = frame })
		TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	end

	-- 너무 많이 쌓이면 오래된 것부터 삭제
	local toasts = {}
	for _, child in toastHolder:GetChildren() do
		if child:IsA("Frame") then
			table.insert(toasts, child)
		end
	end
	table.sort(toasts, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	while #toasts > 6 do
		table.remove(toasts, 1):Destroy()
	end

	task.delay(duration or (if big then 4 else 2.5), function()
		if not frame.Parent then
			return
		end
		local info = TweenInfo.new(0.4)
		TweenService:Create(frame, info, { BackgroundTransparency = 1 }):Play()
		TweenService:Create(label, info, { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		local stroke = frame:FindFirstChildOfClass("UIStroke")
		if stroke then
			TweenService:Create(stroke, info, { Transparency = 1 }):Play()
		end
		task.wait(0.45)
		frame:Destroy()
	end)
end

return Hud
]]></string></Properties></Item><Item class="LocalScript" referent="RBX0000001D"><Properties><string name="Name">Main</string><string name="Source"><![CDATA[-- 클라이언트 시작점: UI, 발굴 입력, 서버 알림 처리
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TextChatService = game:GetService("TextChatService")

local Config = require(ReplicatedStorage.Shared.Config)
local Economy = require(ReplicatedStorage.Shared.Economy)
local Util = require(ReplicatedStorage.Shared.Util)

local Client = script.Parent
local Hud = require(Client.Hud)
local PanelManager = require(Client.PanelManager)
local Digger = require(Client.Digger)
local Effects = require(Client.Effects)
local Barriers = require(Client.Barriers)
local HelperVisuals = require(Client.HelperVisuals)

local player = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local actionRemote = remotes:WaitForChild("Action") :: RemoteFunction
local syncRemote = remotes:WaitForChild("Sync") :: RemoteEvent
local notifyRemote = remotes:WaitForChild("Notify") :: RemoteEvent
local effectRemote = remotes:WaitForChild("Effect") :: RemoteEvent
local tradeRemote = remotes:WaitForChild("Trade") :: RemoteEvent

local snapshot: any = nil

----------------------------------------------------------------------
-- 효과음 (Roblox 기본 내장 소리)
----------------------------------------------------------------------
local function makeSound(id: string, volume: number): Sound
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Volume = volume
	sound.Parent = SoundService
	return sound
end
local sounds = {
	dig = makeSound("rbxasset://sounds/action_footsteps_plastic.mp3", 0.5),
	find = makeSound("rbxasset://sounds/electronicpingshort.wav", 0.6),
}
local function play(name: string, pitch: number?)
	local sound = sounds[name]
	if sound then
		sound.PlaybackSpeed = pitch or 1
		SoundService:PlayLocalSound(sound)
	end
end

----------------------------------------------------------------------
-- 서버 요청
----------------------------------------------------------------------
local function invoke(action: string, ...: any): (boolean, any)
	local args = table.pack(...)
	local ok, success, message = pcall(function()
		return actionRemote:InvokeServer(action, table.unpack(args, 1, args.n))
	end)
	if not ok then
		return false, "서버와 연결이 불안정해요"
	end
	return success == true, message
end

local function request(action: string, ...: any)
	local args = table.pack(...)
	task.spawn(function()
		local success, message = invoke(action, table.unpack(args, 1, args.n))
		if type(message) == "string" then
			Hud.Toast(message, if success then Color3.fromRGB(140, 255, 140) else Color3.fromRGB(255, 140, 140), success)
		end
	end)
end

----------------------------------------------------------------------
local function updateBadges()
	if not snapshot then
		return
	end
	local canAssemble = false
	for speciesId in snapshot.pieces do
		if Economy.HasAllPieces(snapshot, speciesId) then
			canAssemble = true
			break
		end
	end
	Hud.SetBadge("Collection", canAssemble)

	local canBuy = false
	for _, def in Config.Tools do
		if not snapshot.ownedTools[def.id] and snapshot.coins >= def.price then
			canBuy = true
			break
		end
	end
	Hud.SetBadge("Shop", canBuy)

	local canZone = false
	for i, zone in Config.Zones do
		local previous = Config.Zones[i - 1]
		if not snapshot.unlockedZones[zone.id] and (not previous or snapshot.unlockedZones[previous.id]) and snapshot.coins >= zone.price then
			canZone = true
		end
	end
	Hud.SetBadge("Zones", canZone)

	local questReady = snapshot.daily.last ~= snapshot.today
	if snapshot.quests.day == snapshot.today then
		for _, quest in snapshot.quests.list do
			if quest.progress >= quest.target and not quest.claimed then
				questReady = true
			end
		end
	end
	Hud.SetBadge("Quests", questReady)
	Hud.SetBadge("Rebirth", snapshot.coins >= snapshot.rebirthPrice)
	Hud.SetBadge("Helpers", #snapshot.helpersEquipped < snapshot.helperSlots and snapshot.coins >= Config.Helpers[1].price)
end

local function applySnapshot(newSnapshot: any)
	if type(newSnapshot) ~= "table" then
		return
	end
	local first = snapshot == nil
	snapshot = newSnapshot
	Hud.SetCoins(snapshot.coins)
	Hud.SetIncome(snapshot.income)
	PanelManager.Update(snapshot)
	Barriers.Update(snapshot.unlockedZones)
	updateBadges()
	if first and snapshot.daily.last ~= snapshot.today then
		task.delay(2, function()
			Hud.Toast("🎁 오늘의 접속 보상이 있어요! 📜 퀘스트 메뉴에서 받으세요", Color3.fromRGB(255, 220, 100), true, 6)
		end)
	end
end

local function refreshSnapshot()
	local ok, data = invoke("GetSnapshot")
	if ok and data then
		applySnapshot(data)
	end
end

----------------------------------------------------------------------
Hud.Create(function(id: string)
	if id == "Museum" then
		PanelManager.Close()
		request("Teleport", "Museum")
	else
		PanelManager.Toggle(id)
	end
end)
PanelManager.Create(Hud.GetScreen(), request, invoke, refreshSnapshot)
HelperVisuals.Init()

Digger.Init(function()
	return if snapshot then snapshot.cooldown else 0.55
end, function()
	Hud.Toast("조금 더 가까이 가서 파세요!", Color3.fromRGB(255, 200, 120))
end, function()
	if snapshot and snapshot.passes.AutoDig and snapshot.autoDig then
		return true, snapshot.unlockedZones
	end
	return false, {}
end)

syncRemote.OnClientEvent:Connect(applySnapshot)

player:GetAttributeChangedSignal("Coins"):Connect(function()
	local coins = player:GetAttribute("Coins") :: number
	if coins then
		Hud.SetCoins(coins)
		PanelManager.OnCoins(coins)
		updateBadges()
	end
end)

local function systemMessage(text: string)
	pcall(function()
		local channels = TextChatService:FindFirstChild("TextChannels")
		local general = channels and channels:FindFirstChild("RBXGeneral") :: TextChannel?
		if general then
			general:DisplaySystemMessage(text)
		end
	end)
end

notifyRemote.OnClientEvent:Connect(function(payload: any)
	if type(payload) ~= "table" then
		return
	end
	if payload.kind == "Dig" then
		if payload.helper then
			HelperVisuals.Hop(player)
		end
		Effects.FloatText(payload.position, "+" .. Util.FormatNumber(payload.coins) .. " 💰", Color3.fromRGB(255, 220, 80))
		if payload.speciesId then
			local species = Config.SpeciesById[payload.speciesId]
			local rarity = Config.RarityById[species.rarity]
			local pieceName = Config.GetPieces(species)[payload.pieceIndex]
			local text = string.format("%s[%s] %s · %s", if payload.helper then "🦖 " else "", rarity.name, species.name, pieceName)
			if payload.isNew then
				text = "✨ NEW! " .. text
			end
			local big = rarity.tier >= 3 or payload.isNew
			Hud.Toast(text, rarity.color, big)
			if big then
				play("find", 0.8 + rarity.tier * 0.1)
			end
			if payload.complete and payload.isNew then
				Hud.Toast("🦴 " .. species.name .. " 조각을 모두 모았어요! 📖 도감에서 조립하세요", Color3.fromRGB(140, 255, 140), true, 5)
			end
		end
	elseif payload.kind == "Text" then
		Hud.Toast(payload.text, payload.color)
	elseif payload.kind == "Announce" then
		Hud.Toast(payload.text, payload.color or Color3.fromRGB(255, 220, 120), true, 5)
		systemMessage(payload.text)
	elseif payload.kind == "Offline" then
		Hud.Toast(
			string.format("🏛️ 자리를 비운 %s 동안 관람객이 💰 %s 코인을 냈어요!", Util.FormatTime(payload.seconds), Util.FormatNumber(payload.coins)),
			Color3.fromRGB(255, 220, 80),
			true,
			7
		)
	end
end)

effectRemote.OnClientEvent:Connect(function(kind: string, position: Vector3, color: Color3, big: boolean)
	if kind == "Dig" then
		Effects.DirtBurst(position, color, big)
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root and (root.Position - position).Magnitude < 30 then
			play("dig", if big then 0.8 else 1 + math.random() * 0.2)
		end
	end
end)

tradeRemote.OnClientEvent:Connect(function(payload: any)
	if type(payload) ~= "table" then
		return
	end
	if payload.type == "Request" then
		Hud.Prompt(payload.fromName .. "님이 거래를 요청했어요!", "수락", "거절", function(accept)
			request("TradeRespond", payload.fromId, accept)
		end, 30)
	elseif payload.type == "State" then
		PanelManager.SetTrade(payload)
	elseif payload.type == "Closed" then
		PanelManager.SetTrade(nil)
		if payload.reason ~= "done" then
			Hud.Toast("🤝 " .. tostring(payload.reason), Color3.fromRGB(255, 200, 140))
		end
	end
end)

-- 이벤트 배너 / 부스트 타이머
task.spawn(function()
	while true do
		local now = workspace:GetServerTimeNow()
		if ReplicatedStorage:GetAttribute("MeteorActive") then
			local endsAt = ReplicatedStorage:GetAttribute("MeteorEndsAt") or now
			Hud.SetEvent("☄️ 운석 낙하 중! " .. Util.FormatTime(endsAt - now))
		else
			local nextAt = ReplicatedStorage:GetAttribute("NextMeteorAt")
			Hud.SetEvent(if nextAt then "☄️ 다음 운석까지 " .. Util.FormatTime(nextAt - now) else "☄️ 운석 대기 중")
		end
		if snapshot then
			Hud.SetBoost((snapshot.luckBoostUntil or 0) - os.time())
		end
		local serverLuck = ReplicatedStorage:GetAttribute("ServerLuckUntil")
		Hud.SetServerLuck(if type(serverLuck) == "number" then serverLuck - os.time() else 0)
		task.wait(0.5)
	end
end)

-- 처음 데이터 받아오기 (서버가 아직 불러오는 중이면 재시도)
task.spawn(function()
	for _ = 1, 30 do
		local ok, data = invoke("GetSnapshot")
		if ok and data then
			applySnapshot(data)
			return
		end
		task.wait(1)
	end
end)

Hud.Toast("⛏️ 삽을 들고 흙더미를 클릭하세요! 화석 조각을 모아 박물관을 채워요", Color3.fromRGB(255, 230, 160), true, 6)
]]></string></Properties></Item><Item class="ModuleScript" referent="RBX0000001E"><Properties><string name="Name">PanelKit</string><string name="Source"><![CDATA[-- 창(패널) 공통 부품: 틀, 탭, 목록 줄, 버튼
local Gui = require(script.Parent.Gui)

local PanelKit = {}

export type Panel = {
	id: string,
	frame: Frame,
	title: TextLabel,
	subtitle: TextLabel,
	tabs: Frame,
	list: ScrollingFrame,
}

function PanelKit.Create(screen: ScreenGui, id: string, titleText: string, color: Color3, hasTabs: boolean, onClose: () -> ()): Panel
	local frame = Gui.new("Frame", {
		Name = id,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.53),
		Size = UDim2.fromScale(0.66, 0.76),
		BackgroundColor3 = Gui.Colors.Panel,
		BackgroundTransparency = 0.04,
		Visible = false,
		ZIndex = 10,
		Parent = screen,
	}, {
		Gui.corner(16),
		Gui.stroke(color, 3),
		Gui.new("UISizeConstraint", { MaxSize = Vector2.new(780, 580), MinSize = Vector2.new(330, 300) }),
	})
	local title = Gui.label({
		Position = UDim2.fromOffset(16, 10),
		Size = UDim2.new(1, -80, 0, 32),
		Font = Enum.Font.FredokaOne,
		TextColor3 = color,
		Text = titleText,
		MaxTextSize = 28,
		ZIndex = 11,
		Parent = frame,
	})
	local subtitle = Gui.label({
		Position = UDim2.fromOffset(16, 42),
		Size = UDim2.new(1, -80, 0, 20),
		TextColor3 = Gui.Colors.SubText,
		Text = "",
		MaxTextSize = 15,
		ZIndex = 11,
		Parent = frame,
	})
	Gui.button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 10),
		Size = UDim2.fromOffset(40, 40),
		BackgroundColor3 = Gui.Colors.Red,
		Text = "X",
		ZIndex = 11,
		Parent = frame,
	}, onClose)
	local tabs = Gui.new("Frame", {
		Name = "Tabs",
		Position = UDim2.fromOffset(12, 68),
		Size = UDim2.new(1, -24, 0, if hasTabs then 34 else 0),
		BackgroundTransparency = 1,
		Visible = hasTabs,
		ZIndex = 11,
		Parent = frame,
	}, { Gui.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6) }) })
	local top = if hasTabs then 108 else 70
	local list = Gui.new("ScrollingFrame", {
		Position = UDim2.fromOffset(12, top),
		Size = UDim2.new(1, -24, 1, -(top + 12)),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ZIndex = 11,
		Parent = frame,
	}, {
		Gui.new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
		Gui.new("UIPadding", { PaddingRight = UDim.new(0, 10), PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4) }),
	})
	return { id = id, frame = frame, title = title, subtitle = subtitle, tabs = tabs, list = list }
end

function PanelKit.Clear(panel: Panel)
	for _, child in panel.list:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

function PanelKit.SetTabs(panel: Panel, tabs: { { id: string, text: string, color: Color3? } }, selected: string, onSelect: (string) -> ())
	for _, child in panel.tabs:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	for i, tab in tabs do
		Gui.button({
			LayoutOrder = i,
			Size = UDim2.new(1 / #tabs, -6, 1, 0),
			BackgroundColor3 = if tab.id == selected then (tab.color or Gui.Colors.Blue) else Gui.Colors.PanelLight,
			Text = tab.text,
			MaxTextSize = 16,
			ZIndex = 12,
			Parent = panel.tabs,
		}, function()
			onSelect(tab.id)
		end)
	end
end

function PanelKit.Row(panel: Panel, order: number, height: number, strokeColor: Color3?): Frame
	return Gui.new("Frame", {
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, height),
		BackgroundColor3 = Gui.Colors.PanelLight,
		ZIndex = 12,
		Parent = panel.list,
	}, { Gui.corner(10), Gui.stroke(strokeColor or Color3.new(0, 0, 0), 1.5) })
end

function PanelKit.Header(panel: Panel, order: number, text: string, color: Color3)
	Gui.label({
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, 28),
		Font = Enum.Font.FredokaOne,
		TextColor3 = color,
		Text = text,
		MaxTextSize = 22,
		ZIndex = 12,
		Parent = panel.list,
	})
end

function PanelKit.Note(panel: Panel, order: number, text: string)
	Gui.label({
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, 22),
		TextColor3 = Gui.Colors.SubText,
		Text = text,
		MaxTextSize = 15,
		ZIndex = 12,
		Parent = panel.list,
	})
end

-- 줄 왼쪽 위 큰 글씨 + 아래 작은 글씨
function PanelKit.RowText(row: Frame, title: string, sub: string?, titleColor: Color3?, rightSpace: number?)
	local space = rightSpace or 170
	Gui.label({
		Position = UDim2.fromOffset(12, 6),
		Size = UDim2.new(1, -space, 0, 24),
		Font = Enum.Font.FredokaOne,
		TextColor3 = titleColor or Gui.Colors.Text,
		Text = title,
		MaxTextSize = 20,
		ZIndex = 13,
		Parent = row,
	})
	if sub then
		Gui.label({
			Position = UDim2.fromOffset(12, 32),
			Size = UDim2.new(1, -space, 0, 18),
			TextColor3 = Gui.Colors.SubText,
			Text = sub,
			MaxTextSize = 14,
			ZIndex = 13,
			Parent = row,
		})
	end
end

-- 줄 오른쪽 버튼. slot = 오른쪽에서 몇 번째 (1부터)
function PanelKit.RowButton(row: Frame, text: string, color: Color3, onClick: () -> (), slot: number?, width: number?): TextButton
	local w = width or 140
	local index = (slot or 1) - 1
	return Gui.button({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10 - index * (w + 8), 0.5, 0),
		Size = UDim2.fromOffset(w, 38),
		BackgroundColor3 = color,
		Text = text,
		ZIndex = 13,
		Parent = row,
	}, onClick)
end

return PanelKit
]]></string></Properties></Item><Item class="ModuleScript" referent="RBX0000001F"><Properties><string name="Name">PanelManager</string><string name="Source"><![CDATA[-- 창 관리: 열기/닫기, 데이터가 바뀌면 다시 그리기
local PanelKit = require(script.Parent.PanelKit)

local PanelFolder = script.Parent:WaitForChild("Panels")
local MODULES = {
	require(PanelFolder:WaitForChild("Collection")),
	require(PanelFolder:WaitForChild("Shop")),
	require(PanelFolder:WaitForChild("Zones")),
	require(PanelFolder:WaitForChild("Helpers")),
	require(PanelFolder:WaitForChild("Quests")),
	require(PanelFolder:WaitForChild("Rebirth")),
	require(PanelFolder:WaitForChild("Trade")),
}

local PanelManager = {}

type Entry = { module: any, panel: PanelKit.Panel, ctx: any }
local entries: { [string]: Entry } = {}
local openId: string? = nil
local snapshot: any = nil
local tradeState: any = nil

local function render(id: string)
	local entry = entries[id]
	if not entry or not snapshot then
		return
	end
	local list = entry.panel.list
	local pos = list.CanvasPosition
	entry.ctx.trade = tradeState
	entry.module.render(entry.panel, snapshot, entry.ctx)
	task.defer(function()
		list.CanvasPosition = pos
	end)
end

function PanelManager.Create(screen: ScreenGui, request: (string, ...any) -> (), invoke: (string, ...any) -> (boolean, any), refreshSnapshot: () -> ())
	for _, module in MODULES do
		local panel = PanelKit.Create(screen, module.id, module.title, module.color, module.tabs == true, function()
			PanelManager.Close()
		end)
		local ctx = {
			state = {},
			request = request,
			invoke = invoke,
			refreshSnapshot = refreshSnapshot,
			rerender = function()
				if openId == module.id then
					render(module.id)
				end
			end,
			close = function()
				PanelManager.Close()
			end,
		}
		entries[module.id] = { module = module, panel = panel, ctx = ctx }
	end
end

function PanelManager.Open(id: string)
	if openId == id then
		return
	end
	PanelManager.Close()
	local entry = entries[id]
	if not entry then
		return
	end
	openId = id
	entry.panel.frame.Visible = true
	render(id)
	if entry.module.onOpen then
		task.spawn(entry.module.onOpen, entry.panel, entry.ctx)
	end
end

function PanelManager.Toggle(id: string)
	if openId == id then
		PanelManager.Close()
	else
		PanelManager.Open(id)
	end
end

function PanelManager.Close()
	if openId and entries[openId] then
		entries[openId].panel.frame.Visible = false
	end
	openId = nil
end

function PanelManager.Update(newSnapshot: any)
	snapshot = newSnapshot
	if openId then
		render(openId)
	end
end

function PanelManager.OnCoins(coins: number)
	if snapshot then
		snapshot.coins = coins
	end
end

-- 거래 상태 (nil = 거래 안 함)
function PanelManager.SetTrade(state: any)
	if state then
		state.lockUntil = os.clock() + (state.lockLeft or 0)
	end
	tradeState = state
	if state then
		PanelManager.Open("Trade")
	end
	if openId == "Trade" then
		render("Trade")
	end
end

return PanelManager
]]></string></Properties></Item><Item class="Folder" referent="RBX00000027"><Properties><string name="Name">Panels</string></Properties><Item class="ModuleScript" referent="RBX00000020"><Properties><string name="Name">Collection</string><string name="Source"><![CDATA[-- 📖 화석 도감: 지역별 탭, 조각 현황, 조립, 중복 판매
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Economy = require(ReplicatedStorage.Shared.Economy)
local Util = require(ReplicatedStorage.Shared.Util)
local Gui = require(script.Parent.Parent.Gui)
local PanelKit = require(script.Parent.Parent.PanelKit)

local Collection = {
	id = "Collection",
	title = "📖 화석 도감",
	color = Color3.fromRGB(230, 170, 80),
	tabs = true,
}

local TABS = {}
for _, zone in Config.Zones do
	table.insert(TABS, { id = zone.id, text = zone.emoji .. " " .. zone.name:gsub(" .*", ""), color = zone.barrierColor:Lerp(Color3.new(0, 0, 0), 0.3) })
end
table.insert(TABS, { id = "Event", text = "☄️ 우주", color = Color3.fromRGB(80, 60, 140) })

function Collection.render(panel: PanelKit.Panel, snapshot: any, ctx: any)
	local selected = ctx.state.zone or "Desert"
	PanelKit.SetTabs(panel, TABS, selected, function(id)
		ctx.state.zone = id
		ctx.rerender()
	end)
	PanelKit.Clear(panel)

	local progress = Economy.GetZoneProgress(snapshot)
	local total, done = 0, 0
	for _, entry in progress do
		total += entry.total
		done += entry.done
	end
	panel.subtitle.Text = string.format(
		"완성 %d/%d종 · 전시 %d/%d칸 · 수입 배수 x%.2f · ❤️ %s",
		done,
		total,
		#Economy.GetDisplayed(snapshot),
		snapshot.slots,
		Economy.GetIncomeMultiplier(snapshot, snapshot.passes),
		Util.FormatNumber(snapshot.likes)
	)

	local order = 1
	local dupValue = Economy.GetDuplicateValue(snapshot)
	local sellRow = PanelKit.Row(panel, order, 46)
	Gui.label({
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(1, -210, 1, 0),
		Text = "같은 조각은 1개만 있으면 돼요. 남는 조각은 팔거나 🤝 거래할 수 있어요.",
		TextColor3 = Gui.Colors.SubText,
		MaxTextSize = 15,
		ZIndex = 13,
		Parent = sellRow,
	})
	Gui.button({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.fromOffset(190, 34),
		BackgroundColor3 = if dupValue > 0 then Gui.Colors.Gold else Gui.Colors.Disabled,
		TextColor3 = Color3.fromRGB(40, 30, 10),
		Text = "전체 중복 판매 +" .. Util.FormatNumber(dupValue),
		ZIndex = 13,
		Parent = sellRow,
	}, function()
		ctx.request("SellDuplicates")
	end)

	local zoneInfo = progress[selected] or { done = 0, total = 0 }
	order += 1
	local zone = Config.ZoneById[selected]
	PanelKit.Note(
		panel,
		order,
		string.format(
			"%s 완성 %d/%d종%s · 화석 수입 x%s",
			if zone then zone.name else "운석 이벤트",
			zoneInfo.done,
			zoneInfo.total,
			if zoneInfo.done >= zoneInfo.total and zoneInfo.total > 0 then " ✅ 지역 완성 보너스 +25%" else " (모두 완성하면 수입 +25%)",
			Util.FormatNumber(Economy.ZoneMult(selected))
		)
	)

	local byRarity = Config.SpeciesByZoneRarity[selected] or {}
	for _, rarity in Config.Rarities do
		local list = byRarity[rarity.id]
		if list then
			order += 1
			PanelKit.Header(panel, order, rarity.name, rarity.color)
			for _, sp in list do
				order += 1
				local owned = snapshot.pieces[sp.id] or {}
				local completedCount = snapshot.museum[sp.id] or 0
				local pieces = Config.GetPieces(sp)
				local have = 0
				for i = 1, #pieces do
					if (owned[tostring(i)] or 0) > 0 then
						have += 1
					end
				end
				local discovered = have > 0 or completedCount > 0
				local complete = have == #pieces
				local row = PanelKit.Row(panel, order, 74, if complete then rarity.color else nil)

				Gui.label({
					Position = UDim2.fromOffset(12, 6),
					Size = UDim2.new(0.5, -12, 0, 24),
					Font = Enum.Font.FredokaOne,
					TextColor3 = if discovered then rarity.color else Gui.Colors.Disabled,
					Text = if discovered then sp.name else "???",
					MaxTextSize = 20,
					ZIndex = 13,
					Parent = row,
				})
				Gui.label({
					Position = UDim2.new(0.5, 0, 0, 8),
					Size = UDim2.new(0.5, -150, 0, 20),
					TextColor3 = Gui.Colors.SubText,
					TextXAlignment = Enum.TextXAlignment.Right,
					Text = string.format("%d/%d · 완성 %d개", have, #pieces, completedCount),
					MaxTextSize = 15,
					ZIndex = 13,
					Parent = row,
				})

				local chips = Gui.new("Frame", {
					Position = UDim2.fromOffset(12, 36),
					Size = UDim2.new(1, -160, 0, 30),
					BackgroundTransparency = 1,
					ZIndex = 13,
					Parent = row,
				}, { Gui.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4) }) })
				for i, pieceName in pieces do
					local count = owned[tostring(i)] or 0
					local chip = Gui.new("Frame", {
						Size = UDim2.new(1 / #pieces, -4, 1, 0),
						BackgroundColor3 = if count > 0 then rarity.color else Color3.fromRGB(35, 30, 26),
						BackgroundTransparency = if count > 0 then 0.25 else 0,
						ZIndex = 13,
						Parent = chips,
					}, { Gui.corner(6) })
					Gui.label({
						Size = UDim2.new(1, -6, 1, -4),
						Position = UDim2.fromOffset(3, 2),
						TextXAlignment = Enum.TextXAlignment.Center,
						TextColor3 = if count > 0 then Color3.new(1, 1, 1) else Gui.Colors.Disabled,
						TextStrokeTransparency = if count > 0 then 0.4 else 1,
						Text = if count > 1 then pieceName .. " x" .. count elseif count == 1 then pieceName else "?",
						MaxTextSize = 14,
						ZIndex = 14,
						Parent = chip,
					})
				end

				Gui.button({
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, -10, 0.5, 8),
					Size = UDim2.fromOffset(130, 38),
					BackgroundColor3 = if complete then Gui.Colors.Green else Gui.Colors.Disabled,
					Text = if complete then "🦴 조립하기" else string.format("+%s/초", Util.FormatNumber(Economy.SpeciesIncome(sp))),
					AutoButtonColor = complete,
					ZIndex = 13,
					Parent = row,
				}, function()
					if complete then
						ctx.request("Assemble", sp.id)
					end
				end)
			end
		end
	end
end

return Collection
]]></string></Properties></Item><Item class="ModuleScript" referent="RBX00000021"><Properties><string name="Name">Helpers</string><string name="Source"><![CDATA[-- 🦖 발굴 조수: 고용, 데리고 다니기
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Economy = require(ReplicatedStorage.Shared.Economy)
local Util = require(ReplicatedStorage.Shared.Util)
local Gui = require(script.Parent.Parent.Gui)
local PanelKit = require(script.Parent.Parent.PanelKit)

local Helpers = {
	id = "Helpers",
	title = "🦖 발굴 조수",
	color = Color3.fromRGB(120, 210, 100),
	tabs = false,
}

function Helpers.render(panel: PanelKit.Panel, snapshot: any, ctx: any)
	PanelKit.Clear(panel)
	local slots = snapshot.helperSlots
	panel.subtitle.Text = string.format("데리고 다니는 조수 %d/%d마리 · 내가 서 있는 지역에서 알아서 흙더미를 파요", #snapshot.helpersEquipped, slots)

	local order = 1
	PanelKit.Header(panel, order, "함께 다니는 조수", Gui.Colors.Gold)
	if #snapshot.helpersEquipped == 0 then
		order += 1
		PanelKit.Note(panel, order, "아직 없어요. 아래에서 고용해 보세요!")
	end
	for _, id in snapshot.helpersEquipped do
		local helper = Config.HelperById[id]
		if helper then
			order += 1
			local row = PanelKit.Row(panel, order, 50, helper.color)
			PanelKit.RowText(row, helper.name, nil, helper.color)
			PanelKit.RowButton(row, "쉬게 하기", Gui.Colors.Red, function()
				ctx.request("UnequipHelper", id)
			end)
		end
	end

	order += 1
	PanelKit.Header(panel, order, "고용하기", Color3.fromRGB(120, 210, 100))
	for _, helper in Config.Helpers do
		order += 1
		local owned = snapshot.helpersOwned[helper.id] or 0
		local equipped = Economy.CountEquipped(snapshot, helper.id)
		local row = PanelKit.Row(panel, order, 58)
		PanelKit.RowText(
			row,
			helper.name .. (if owned > 0 then string.format("  (보유 %d)", owned) else ""),
			string.format("%.1f초마다 흙더미 1개 · 조각 확률 %d%%", helper.interval, math.floor(Config.HelperPieceChance * 100)),
			helper.color,
			320
		)
		PanelKit.RowButton(row, "💰 " .. Util.FormatNumber(helper.price), if snapshot.coins >= helper.price then Gui.Colors.Green else Gui.Colors.Disabled, function()
			ctx.request("BuyHelper", helper.id)
		end)
		if owned > equipped then
			PanelKit.RowButton(row, "데리고 다니기", if #snapshot.helpersEquipped < slots then Gui.Colors.Blue else Gui.Colors.Disabled, function()
				ctx.request("EquipHelper", helper.id)
			end, 2)
		end
	end
	order += 1
	PanelKit.Note(panel, order, if snapshot.passes.ExtraHelpers then "✅ 조수 칸 +2 패스 적용 중" else "💎 상점의 '조수 칸 +2' 패스로 조수를 더 데리고 다닐 수 있어요")
end

return Helpers
]]></string></Properties></Item><Item class="ModuleScript" referent="RBX00000022"><Properties><string name="Name">Quests</string><string name="Source"><![CDATA[-- 📜 퀘스트 + 🎁 매일 보상
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Gui = require(script.Parent.Parent.Gui)
local PanelKit = require(script.Parent.Parent.PanelKit)

local Quests = {
	id = "Quests",
	title = "📜 퀘스트 & 매일 보상",
	color = Color3.fromRGB(255, 200, 90),
	tabs = false,
}

local TIER_NAMES = { "쉬움", "보통", "어려움" }
local TEMPLATE_BY_TYPE = {}
for _, template in Config.QuestTemplates do
	TEMPLATE_BY_TYPE[template.type] = template
end

function Quests.onOpen(_panel: PanelKit.Panel, ctx: any)
	local ok, rewards = ctx.invoke("GetQuestRewards")
	if ok and type(rewards) == "table" then
		ctx.state.rewards = rewards
	end
	ctx.refreshSnapshot()
	ctx.rerender()
end

function Quests.render(panel: PanelKit.Panel, snapshot: any, ctx: any)
	PanelKit.Clear(panel)
	local rewards = ctx.state.rewards or {}
	panel.subtitle.Text = "퀘스트는 매일 새로 바뀌어요 (한국 시간 오전 9시)"

	-- 매일 보상
	local order = 1
	PanelKit.Header(panel, order, "🎁 매일 접속 보상", Gui.Colors.Gold)
	order += 1
	local claimedToday = snapshot.daily.last == snapshot.today
	local streak = snapshot.daily.streak
	local nextStreak = if claimedToday then streak elseif snapshot.daily.last == snapshot.today - 1 then streak + 1 else 1
	local day = ((nextStreak - 1) % #Config.DailyRewards) + 1
	local dailyRow = PanelKit.Row(panel, order, 58, if claimedToday then nil else Gui.Colors.Gold)
	PanelKit.RowText(
		dailyRow,
		string.format("%d일차 보상%s", day, if Config.DailyRewards[day].luckMinutes then " + 🍀 행운 부스트" else ""),
		string.format("연속 접속 %d일 · 7일마다 큰 보상", if claimedToday then streak else nextStreak - 1)
	)
	PanelKit.RowButton(
		dailyRow,
		if claimedToday then "내일 또 와요" else "받기 💰 " .. Util.FormatNumber(rewards.daily or 0),
		if claimedToday then Gui.Colors.Disabled else Gui.Colors.Green,
		function()
			if not claimedToday then
				ctx.request("ClaimDaily")
			end
		end
	)

	-- 일일 퀘스트
	order += 1
	PanelKit.Header(panel, order, "📜 오늘의 퀘스트", Color3.fromRGB(255, 200, 90))
	local list = if snapshot.quests.day == snapshot.today then snapshot.quests.list else {}
	if #list == 0 then
		order += 1
		PanelKit.Note(panel, order, "퀘스트를 불러오는 중...")
	end
	for i, quest in list do
		order += 1
		local template = TEMPLATE_BY_TYPE[quest.type]
		local done = quest.progress >= quest.target
		local row = PanelKit.Row(panel, order, 64, if done and not quest.claimed then Gui.Colors.Green else nil)
		PanelKit.RowText(
			row,
			string.format("[%s] %s", TIER_NAMES[quest.tier] or "?", if template then string.format(template.text, quest.target) else quest.type),
			string.format("진행 %d / %d", quest.progress, quest.target)
		)
		-- 진행 막대
		local bar = Gui.new("Frame", {
			Position = UDim2.new(0, 160, 0, 36),
			Size = UDim2.new(1, -340, 0, 12),
			BackgroundColor3 = Color3.fromRGB(30, 26, 22),
			ZIndex = 13,
			Parent = row,
		}, { Gui.corner(6) })
		Gui.new("Frame", {
			Size = UDim2.fromScale(math.clamp(quest.progress / quest.target, 0, 1), 1),
			BackgroundColor3 = if done then Gui.Colors.Green else Gui.Colors.Gold,
			ZIndex = 14,
			Parent = bar,
		}, { Gui.corner(6) })
		local rewardText = "💰 " .. Util.FormatNumber(rewards.quests and rewards.quests[i] or 0)
		PanelKit.RowButton(
			row,
			if quest.claimed then "받음 ✅" elseif done then "받기 " .. rewardText else rewardText,
			if quest.claimed then Gui.Colors.Disabled elseif done then Gui.Colors.Green else Gui.Colors.PanelLight,
			function()
				if done and not quest.claimed then
					ctx.request("ClaimQuest", i)
				end
			end
		)
	end
	order += 1
	PanelKit.Note(panel, order, string.format("🍀 3개를 모두 끝내면 행운 부스트 %d분 추가!", Config.QuestAllDoneLuckMinutes))
end

return Quests
]]></string></Properties></Item><Item class="ModuleScript" referent="RBX00000023"><Properties><string name="Name">Rebirth</string><string name="Source"><![CDATA[-- 🔁 환생
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Gui = require(script.Parent.Parent.Gui)
local PanelKit = require(script.Parent.Parent.PanelKit)

local Rebirth = {
	id = "Rebirth",
	title = "🔁 환생",
	color = Color3.fromRGB(255, 140, 255),
	tabs = false,
}

function Rebirth.render(panel: PanelKit.Panel, snapshot: any, ctx: any)
	PanelKit.Clear(panel)
	local r = snapshot.rebirths
	panel.subtitle.Text = string.format("지금까지 %d번 환생했어요", r)

	local function bonusLine(count: number): string
		return string.format(
			"박물관 수입 +%d%% · 발굴 코인 +%d%% · 행운 +%d%%",
			math.floor(count * Config.Rebirth.incomeBonus * 100),
			math.floor(count * Config.Rebirth.coinBonus * 100),
			math.floor(count * Config.Rebirth.luckBonus * 100 + 0.5)
		)
	end

	PanelKit.Header(panel, 1, "지금 보너스", Color3.fromRGB(255, 140, 255))
	PanelKit.Note(panel, 2, bonusLine(r))
	PanelKit.Header(panel, 3, "다음 환생 후 보너스", Color3.fromRGB(255, 200, 255))
	PanelKit.Note(panel, 4, bonusLine(r + 1))

	PanelKit.Header(panel, 5, "⚠️ 환생하면", Gui.Colors.Red)
	PanelKit.Note(panel, 6, "초기화: 코인, 발굴 도구, 열린 지역, 전시대 칸 수")
	PanelKit.Note(panel, 7, "유지: 화석 조각, 완성한 화석, 좋아요, 발굴 조수, 게임 패스")

	local price = snapshot.rebirthPrice
	local can = snapshot.coins >= price
	local row = PanelKit.Row(panel, 8, 64, if can then Color3.fromRGB(255, 140, 255) else nil)
	PanelKit.RowText(row, string.format("%d번째 환생", r + 1), string.format("필요한 코인 💰 %s (지금 %s)", Util.FormatNumber(price), Util.FormatNumber(snapshot.coins)), nil, 220)
	local button: TextButton
	button = PanelKit.RowButton(row, if can then "환생하기" else "코인 부족", if can then Color3.fromRGB(200, 80, 220) else Gui.Colors.Disabled, function()
		if not can then
			return
		end
		-- 두 번 눌러야 환생 (실수 방지)
		if ctx.state.confirm then
			ctx.state.confirm = false
			ctx.request("Rebirth")
		else
			ctx.state.confirm = true
			button.Text = "정말요? 한 번 더!"
			task.delay(3, function()
				ctx.state.confirm = false
				if button.Parent then
					button.Text = "환생하기"
				end
			end)
		end
	end, 1, 180)
end

return Rebirth
]]></string></Properties></Item><Item class="ModuleScript" referent="RBX00000024"><Properties><string name="Name">Shop</string><string name="Source"><![CDATA[-- 🛒 상점: 도구, 전시대, Robux
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Economy = require(ReplicatedStorage.Shared.Economy)
local Util = require(ReplicatedStorage.Shared.Util)
local Gui = require(script.Parent.Parent.Gui)
local PanelKit = require(script.Parent.Parent.PanelKit)

local player = Players.LocalPlayer

local Shop = {
	id = "Shop",
	title = "🛒 상점",
	color = Color3.fromRGB(70, 190, 90),
	tabs = true,
}

local TABS = {
	{ id = "Tools", text = "⛏️ 도구" },
	{ id = "Museum", text = "🏛️ 박물관" },
	{ id = "Robux", text = "💎 Robux", color = Color3.fromRGB(60, 160, 75) },
}

local function sorted(map: { [string]: any }): { { key: string, value: any } }
	local list = {}
	for key, value in map do
		table.insert(list, { key = key, value = value })
	end
	table.sort(list, function(a, b)
		return (a.value.order or 0) < (b.value.order or 0)
	end)
	return list
end

local function renderTools(panel: PanelKit.Panel, snapshot: any, ctx: any)
	local order = 0
	for _, def in Config.Tools do
		order += 1
		local owned = snapshot.ownedTools[def.id] == true
		local equipped = snapshot.tool == def.id
		local row = PanelKit.Row(panel, order, 58, if equipped then Gui.Colors.Gold else nil)
		PanelKit.RowText(row, def.name, string.format("파워 %d · 간격 %.2f초 · 행운 +%d%%", def.power, def.cooldown, math.floor(def.luck * 100 + 0.5)), def.color)
		local text, color
		if equipped then
			text, color = "사용 중", Gui.Colors.Disabled
		elseif owned then
			text, color = "장착", Gui.Colors.Blue
		else
			text = "💰 " .. Util.FormatNumber(def.price)
			color = if snapshot.coins >= def.price then Gui.Colors.Green else Gui.Colors.Disabled
		end
		PanelKit.RowButton(row, text, color, function()
			if equipped then
				return
			elseif owned then
				ctx.request("EquipTool", def.id)
			else
				ctx.request("BuyTool", def.id)
			end
		end)
	end
end

local function renderMuseum(panel: PanelKit.Panel, snapshot: any, ctx: any)
	local row = PanelKit.Row(panel, 1, 58)
	local nextPrice = Economy.GetNextSlotPrice(snapshot)
	PanelKit.RowText(row, string.format("전시대 %d/%d칸", snapshot.slots, Config.MaxSlots), "전시한 화석만 관람 수입을 벌어요 (수입이 높은 화석부터 자동 전시)")
	PanelKit.RowButton(row, if nextPrice then "+2칸 💰 " .. Util.FormatNumber(nextPrice) else "최대", if nextPrice and snapshot.coins >= nextPrice then Gui.Colors.Green else Gui.Colors.Disabled, function()
		if nextPrice then
			ctx.request("BuySlot")
		end
	end)

	PanelKit.Header(panel, 2, "📈 지금 내 수입 보너스", Gui.Colors.Gold)
	local unique, zonesDone = 0, 0
	for _, count in snapshot.museum do
		if count > 0 then
			unique += 1
		end
	end
	for _, entry in Economy.GetZoneProgress(snapshot) do
		if entry.done >= entry.total then
			zonesDone += 1
		end
	end
	local lines = {
		string.format("❤️ 좋아요 %d개 → +%d%% (최대 +100%%)", snapshot.likes, math.floor(math.min(snapshot.likes * Config.LikeBonus, Config.MaxLikeBonus) * 100)),
		string.format("🦴 완성한 화석 %d종 → +%d%%", unique, math.floor(unique * Config.UniqueBonus * 100)),
		string.format("🗺️ 완성한 지역 %d곳 → +%d%%", zonesDone, math.floor(zonesDone * Config.ZoneCompleteBonus * 100)),
		string.format("🔁 환생 %d회 → +%d%%", snapshot.rebirths, math.floor(snapshot.rebirths * Config.Rebirth.incomeBonus * 100)),
		if snapshot.passes.DoubleIncome then "🏛️ 수입 2배 패스 → x2" else "🏛️ 수입 2배 패스 없음",
	}
	for i, line in lines do
		PanelKit.Note(panel, 2 + i, line)
	end
end

local function renderRobux(panel: PanelKit.Panel, snapshot: any, ctx: any)
	local order = 1
	PanelKit.Header(panel, order, "게임 패스 (한 번 사면 영원히)", Color3.fromRGB(120, 230, 120))
	for _, entry in sorted(Config.GamePasses) do
		order += 1
		local key, pass = entry.key, entry.value
		local row = PanelKit.Row(panel, order, 58)
		local has = snapshot.passes[key] == true
		PanelKit.RowText(row, pass.name, pass.desc)
		if key == "AutoDig" and has then
			PanelKit.RowButton(row, if snapshot.autoDig then "켜짐 ✅" else "꺼짐", if snapshot.autoDig then Gui.Colors.Green else Gui.Colors.Disabled, function()
				ctx.request("ToggleAutoDig")
			end)
		else
			PanelKit.RowButton(row, if has then "보유 중" elseif pass.id == 0 then "준비 중" else "구매", if has or pass.id == 0 then Gui.Colors.Disabled else Color3.fromRGB(60, 180, 75), function()
				if not has and pass.id ~= 0 then
					MarketplaceService:PromptGamePassPurchase(player, pass.id)
				end
			end)
		end
	end
	order += 1
	PanelKit.Header(panel, order, "아이템", Color3.fromRGB(120, 230, 120))
	for _, entry in sorted(Config.Products) do
		order += 1
		local key, product = entry.key, entry.value
		local row = PanelKit.Row(panel, order, 58)
		local desc
		if key == "LuckBoost" then
			desc = "내 행운 x1.5 (여러 번 사면 시간이 늘어나요)"
		elseif key == "ServerLuck" then
			desc = "이 서버 모든 사람의 행운 x2! 다들 고마워해요"
		else
			local coins = math.max(product.minCoins or 0, math.floor(snapshot.income * (product.coinsSeconds or 0)))
			desc = "지금 받으면 💰 " .. Util.FormatNumber(coins)
		end
		PanelKit.RowText(row, product.name, desc)
		PanelKit.RowButton(row, if product.id == 0 then "준비 중" else "구매", if product.id == 0 then Gui.Colors.Disabled else Color3.fromRGB(60, 180, 75), function()
			if product.id ~= 0 then
				MarketplaceService:PromptProductPurchase(player, product.id)
			end
		end)
	end
end

function Shop.render(panel: PanelKit.Panel, snapshot: any, ctx: any)
	local selected = ctx.state.tab or "Tools"
	PanelKit.SetTabs(panel, TABS, selected, function(id)
		ctx.state.tab = id
		ctx.rerender()
	end)
	PanelKit.Clear(panel)
	panel.subtitle.Text = string.format("행운 x%.2f · 삽질 간격 %.2f초 · 💰 %s", snapshot.luck, snapshot.cooldown, Util.FormatNumber(snapshot.coins))
	if selected == "Tools" then
		renderTools(panel, snapshot, ctx)
	elseif selected == "Museum" then
		renderMuseum(panel, snapshot, ctx)
	else
		renderRobux(panel, snapshot, ctx)
	end
end

return Shop
]]></string></Properties></Item><Item class="ModuleScript" referent="RBX00000025"><Properties><string name="Name">Trade</string><string name="Source"><![CDATA[-- 🤝 거래: 플레이어 목록 → 요청 → 서로 조각/코인 올리기 → 둘 다 준비하면 교환
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Gui = require(script.Parent.Parent.Gui)
local PanelKit = require(script.Parent.Parent.PanelKit)

local player = Players.LocalPlayer

local Trade = {
	id = "Trade",
	title = "🤝 거래",
	color = Color3.fromRGB(100, 200, 255),
	tabs = false,
}

local function pieceLabel(speciesId: string, pieceIndex: number): (string, Color3)
	local species = Config.SpeciesById[speciesId]
	if not species then
		return "?", Gui.Colors.Text
	end
	local rarity = Config.RarityById[species.rarity]
	return string.format("[%s] %s · %s", rarity.name, species.name, Config.GetPieces(species)[pieceIndex] or "?"), rarity.color
end

local function renderLobby(panel: PanelKit.Panel, ctx: any)
	panel.subtitle.Text = "같은 서버의 친구와 화석 조각, 코인을 바꿀 수 있어요"
	local order = 0
	for _, other in Players:GetPlayers() do
		if other ~= player then
			order += 1
			local row = PanelKit.Row(panel, order, 52)
			PanelKit.RowText(row, other.DisplayName, "@" .. other.Name)
			PanelKit.RowButton(row, "거래 요청", Gui.Colors.Blue, function()
				ctx.request("TradeRequest", other.UserId)
			end)
		end
	end
	if order == 0 then
		PanelKit.Note(panel, 1, "서버에 다른 플레이어가 없어요. 친구를 초대해 보세요!")
	end
	PanelKit.Note(panel, 100, "🛡️ 내용이 바뀌면 '준비'가 풀리고, 둘 다 준비해야만 교환돼요")
end

local function renderTrade(panel: PanelKit.Panel, snapshot: any, ctx: any, trade: any)
	local now = os.clock()
	panel.subtitle.Text = string.format("%s님과 거래 중 · 둘 다 '준비'를 누르면 교환돼요", trade.them.name)
	local order = 0
	local function nextOrder(): number
		order += 1
		return order
	end

	-- 상대가 주는 것
	PanelKit.Header(panel, nextOrder(), string.format("📥 %s님이 줄 것 %s", trade.them.name, if trade.them.ready then "✅ 준비됨" else "⏳"), Color3.fromRGB(140, 220, 255))
	if #trade.them.items == 0 and trade.them.coins == 0 then
		PanelKit.Note(panel, nextOrder(), "아직 아무것도 올리지 않았어요")
	end
	if trade.them.coins > 0 then
		PanelKit.Note(panel, nextOrder(), "💰 " .. Util.FormatNumber(trade.them.coins) .. " 코인")
	end
	for _, item in trade.them.items do
		local text, color = pieceLabel(item.speciesId, item.pieceIndex)
		local row = PanelKit.Row(panel, nextOrder(), 40, color)
		PanelKit.RowText(row, text .. "  x" .. item.count, nil, color, 20)
	end

	-- 내가 주는 것
	PanelKit.Header(panel, nextOrder(), string.format("📤 내가 줄 것 %s", if trade.me.ready then "✅ 준비됨" else ""), Gui.Colors.Gold)
	local myOffer: { [string]: number } = {}
	for _, item in trade.me.items do
		myOffer[item.speciesId .. "|" .. item.pieceIndex] = item.count
		local text, color = pieceLabel(item.speciesId, item.pieceIndex)
		local row = PanelKit.Row(panel, nextOrder(), 44, color)
		PanelKit.RowText(row, text .. "  x" .. item.count, nil, color, 120)
		PanelKit.RowButton(row, "빼기", Gui.Colors.Red, function()
			ctx.request("TradeSetItem", item.speciesId, item.pieceIndex, item.count - 1)
		end, 1, 100)
	end

	local coinRow = PanelKit.Row(panel, nextOrder(), 52)
	PanelKit.RowText(coinRow, "💰 코인 " .. Util.FormatNumber(trade.me.coins), "보유 " .. Util.FormatNumber(snapshot.coins), nil, 300)
	local box = Gui.new("TextBox", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -118, 0.5, 0),
		Size = UDim2.fromOffset(150, 36),
		BackgroundColor3 = Color3.fromRGB(25, 22, 18),
		TextColor3 = Color3.new(1, 1, 1),
		PlaceholderText = "코인 숫자",
		Text = "",
		Font = Enum.Font.GothamBold,
		TextScaled = true,
		ClearTextOnFocus = false,
		ZIndex = 13,
		Parent = coinRow,
	}, { Gui.corner(8), Gui.new("UITextSizeConstraint", { MaxTextSize = 18 }) })
	PanelKit.RowButton(coinRow, "올리기", Gui.Colors.Blue, function()
		local amount = tonumber((box.Text:gsub("[^%d]", "")))
		if amount then
			ctx.request("TradeSetCoins", amount)
		end
	end, 1, 100)

	-- 준비 / 취소
	local actionRow = PanelKit.Row(panel, nextOrder(), 56)
	local locked = now < (trade.lockUntil or 0)
	PanelKit.RowText(actionRow, if trade.me.ready then "상대를 기다리는 중..." else "내용을 확인했으면 준비!", nil, nil, 300)
	PanelKit.RowButton(actionRow, "❌ 취소", Gui.Colors.Red, function()
		ctx.request("TradeCancel")
	end, 1, 120)
	PanelKit.RowButton(actionRow, if trade.me.ready then "✅ 준비됨" elseif locked then "확인 중..." else "✅ 준비", if trade.me.ready or locked then Gui.Colors.Disabled else Gui.Colors.Green, function()
		if not trade.me.ready then
			ctx.request("TradeReady")
		end
	end, 2, 140)
	if locked then
		task.delay((trade.lockUntil or now) - now + 0.05, ctx.rerender)
	end

	-- 내 조각 목록
	PanelKit.Header(panel, nextOrder(), "🦴 내 조각에서 올리기 (누를 때마다 1개씩)", Gui.Colors.SubText)
	local mine = {}
	for speciesId, owned in snapshot.pieces do
		for key, count in owned do
			local pieceIndex = tonumber(key)
			if pieceIndex and count > 0 then
				table.insert(mine, { speciesId = speciesId, pieceIndex = pieceIndex, count = count })
			end
		end
	end
	table.sort(mine, function(a, b)
		local ta = Config.RarityById[Config.SpeciesById[a.speciesId].rarity].tier
		local tb = Config.RarityById[Config.SpeciesById[b.speciesId].rarity].tier
		if ta ~= tb then
			return ta > tb
		end
		return a.speciesId .. a.pieceIndex < b.speciesId .. b.pieceIndex
	end)
	for _, item in mine do
		local offered = myOffer[item.speciesId .. "|" .. item.pieceIndex] or 0
		local text, color = pieceLabel(item.speciesId, item.pieceIndex)
		local row = PanelKit.Row(panel, nextOrder(), 44)
		PanelKit.RowText(row, string.format("%s  (보유 %d)", text, item.count), nil, color, 120)
		PanelKit.RowButton(row, "+1", if offered < item.count then Gui.Colors.Green else Gui.Colors.Disabled, function()
			if offered < item.count then
				ctx.request("TradeSetItem", item.speciesId, item.pieceIndex, offered + 1)
			end
		end, 1, 100)
	end
end

function Trade.render(panel: PanelKit.Panel, snapshot: any, ctx: any)
	PanelKit.Clear(panel)
	if ctx.trade then
		renderTrade(panel, snapshot, ctx, ctx.trade)
	else
		renderLobby(panel, ctx)
	end
end

return Trade
]]></string></Properties></Item><Item class="ModuleScript" referent="RBX00000026"><Properties><string name="Name">Zones</string><string name="Source"><![CDATA[-- 🗺️ 발굴 지역: 열기, 이동
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Economy = require(ReplicatedStorage.Shared.Economy)
local Util = require(ReplicatedStorage.Shared.Util)
local Gui = require(script.Parent.Parent.Gui)
local PanelKit = require(script.Parent.Parent.PanelKit)

local Zones = {
	id = "Zones",
	title = "🗺️ 발굴 지역",
	color = Color3.fromRGB(110, 190, 255),
	tabs = false,
}

function Zones.render(panel: PanelKit.Panel, snapshot: any, ctx: any)
	PanelKit.Clear(panel)
	panel.subtitle.Text = "지역이 멀수록 흙더미가 단단하지만, 화석 수입과 코인이 훨씬 많아요"
	local progress = Economy.GetZoneProgress(snapshot)

	local museumRow = PanelKit.Row(panel, 0, 58, Gui.Colors.Blue)
	PanelKit.RowText(museumRow, "🏛️ 내 박물관", "완성한 화석이 전시된 곳")
	PanelKit.RowButton(museumRow, "이동", Gui.Colors.Blue, function()
		ctx.close()
		ctx.request("Teleport", "Museum")
	end)

	for i, zone in Config.Zones do
		local unlocked = snapshot.unlockedZones[zone.id] == true
		local previous = Config.Zones[i - 1]
		local canUnlock = not previous or snapshot.unlockedZones[previous.id] == true
		local info = progress[zone.id] or { done = 0, total = 0 }
		local row = PanelKit.Row(panel, i, 74, if unlocked then zone.barrierColor else nil)
		local sub = string.format(
			"화석 수입 x%s · 코인 x%s · 흙더미 체력 x%s · 완성 %d/%d종",
			Util.FormatNumber(zone.incomeMult),
			Util.FormatNumber(zone.coinMult),
			tostring(zone.hpMult),
			info.done,
			info.total
		)
		PanelKit.RowText(row, zone.emoji .. " " .. zone.name, sub, if unlocked then zone.barrierColor else Gui.Colors.Text)
		if unlocked then
			PanelKit.RowButton(row, "이동", Gui.Colors.Blue, function()
				ctx.close()
				ctx.request("Teleport", zone.id)
			end)
		elseif not canUnlock then
			PanelKit.RowButton(row, "🔒 이전 지역 먼저", Gui.Colors.Disabled, function() end)
		else
			PanelKit.RowButton(row, "열기 💰 " .. Util.FormatNumber(zone.price), if snapshot.coins >= zone.price then Gui.Colors.Green else Gui.Colors.Disabled, function()
				ctx.request("BuyZone", zone.id)
			end)
		end
	end
	PanelKit.Note(panel, 100, "💡 환생하면 지역이 다시 잠기지만, 영구 보너스로 훨씬 빨리 다시 열 수 있어요")
end

return Zones
]]></string></Properties></Item></Item></Item></Item></Item></roblox>
