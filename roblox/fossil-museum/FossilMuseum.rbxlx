	{ id = "Protoceratops", name = "프로토케라톱스", rarity = "Common", shape = "Quadruped", look = { scale = 0.75, neck = 0.5, tail = 0.8, horns = true } },
	{ id = "Compsognathus", name = "콤프소그나투스", rarity = "Common", shape = "Biped", look = { scale = 0.6, head = 0.7, tail = 1.2 } },
