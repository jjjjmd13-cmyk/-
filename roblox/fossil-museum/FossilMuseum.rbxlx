-- 숫자(가격, 확률, 수입)를 바꿔서 밸런스를 조정하세요.

local Config = {}

----------------------------------------------------------------------
-- 수익화 (Robux)
-- Creator Dashboard 에서 게임 패스 / 개발자 상품을 만든 뒤 ID 를 넣으세요.
-- ID 가 0 이면 상점에 "준비 중" 으로 표시되고 구매할 수 없습니다.
----------------------------------------------------------------------
Config.GamePasses = {
