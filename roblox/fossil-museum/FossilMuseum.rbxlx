	CoinsLarge = { id = 0, order = 3, name = "💰 코인 금고", coinsSeconds = 12000, minCoins = 60000 },
	LuckBoost = { id = 0, order = 4, name = "🍀 행운 부스트 15분", minutes = 15 },
